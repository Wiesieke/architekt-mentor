---
import Studio from '../../layouts/Studio.astro';
import { articles, articleUrl, type Article } from '../../data/articles';

export function getStaticPaths() {
  return articles.map(article => ({ params: { section: article.section, slug: article.slug }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
const sectionTitle = article.section === 'architektura-w-ruchu' ? 'Architektura w ruchu' : 'Podstawy architektury';
const schema = {
  '@context':'https://schema.org', '@type':'Article',
  headline:article.title, description:article.description,
  inLanguage:'pl', articleSection:sectionTitle,
  mainEntityOfPage:new URL(articleUrl(article), 'https://ejsymont.com').href,
  author:{'@type':'Person',name:'Wiesław Ejsymont'},
  ...(article.published ? {datePublished:article.published} : {}),
};
const format = (value: string) => new Intl.DateTimeFormat('pl-PL', {dateStyle:'long',timeZone:'UTC'}).format(new Date(`${value}T12:00:00Z`));
---
<Studio title={article.title} description={article.description} published={article.published}>
  <div class="article-page"><div class="container article-wrap">
    <a class="back" href={`/${article.section}/`}>← {sectionTitle}</a>
    <header><div class="eyebrow">{sectionTitle} · {article.topic}</div><h1>{article.title}</h1><p>{article.description}</p>
      <div class="meta">Wiesław Ejsymont {article.published && <> · Opublikowano <time datetime={article.published}>{format(article.published)}</time></>}{article.eventDate && <> · Data wydarzenia <time datetime={article.eventDate}>{format(article.eventDate)}</time></>}</div>
    </header>
    <article class="article-body" set:html={article.body} />
    <nav class="more" aria-label="Dalsza lektura"><a href={`/${article.section}/`}>Zobacz pozostałe materiały →</a><a href="/lamiglowka/">Przećwicz decyzję →</a></nav>
  </div></div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
</Studio>
<style>
  .article-page{padding:55px 0 95px}.article-wrap{max-width:860px}.back{color:#136d73;font-weight:700;font-size:13px}.article-page header{margin:43px 0 31px}.article-page h1{font-size:clamp(34px,5vw,55px);max-width:20ch;margin:18px 0}.article-page header p{color:#536577;font-size:18px;max-width:67ch}.meta{color:#617880;font-size:12px;margin-top:25px}.article-body{background:#fff;border:1px solid #dce4df;border-radius:14px;padding:clamp(22px,5vw,45px)}
  .article-body :global(p),.article-body :global(li){color:#3d5261;line-height:1.8}.article-body :global(h3){font-size:22px;margin:30px 0 10px}.article-body :global(a){color:#136d73;text-decoration-thickness:2px;text-underline-offset:3px}.article-body :global(.source){border-top:1px solid #dce4df;padding-top:19px;margin-top:32px;font-size:13px}.article-body :global(.example),.article-body :global(.note){background:#e8f4ef;border-radius:9px;padding:17px;margin:23px 0;color:#3d5261}.article-body :global(.grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.article-body :global(.tile){padding:14px;background:#f5f8f5;border-radius:7px}.more{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px}.more a{font-weight:700;color:#136d73}
  @media(max-width:540px){.article-page{padding:27px 0 60px}.article-page header{margin:26px 0}.article-body :global(.grid){grid-template-columns:1fr}}
</style>
