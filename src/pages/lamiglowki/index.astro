---
import Studio from '../../layouts/Studio.astro';
import puzzles from '../../../data/puzzles.json';
const items = [...puzzles].sort((a,b) => b.date.localeCompare(a.date));
const puzzleUrl = (id: string) => `/lamiglowki/${id}/`;
---
<Studio translationUrl="/en/practice/archive/" title="Łamigłówki architektoniczne" description="Archiwum praktycznych łamigłówek: scenariusz, decyzja, pytania i analiza seniora." active="practice">
  <div class="container archive"><div class="eyebrow">Ćwicz decyzje</div><h1>Łamigłówki architektoniczne</h1><p>Zacznij od ćwiczeń łatwych i średnich: szybka decyzja z wyjaśnieniem albo warsztat z mentorem. Starsze ćwiczenia zaawansowane pozostają dostępne.</p>
    <div class="cards">{items.map(item => <article><small>{item.date} · {item.difficulty}</small><h2><a href={puzzleUrl(item.id)}>{item.title}</a></h2><p>{item.goal || item.scenario.split(/\n\n+/)[1] || item.scenario}</p><a href={puzzleUrl(item.id)}>Otwórz ćwiczenie →</a></article>)}</div>
  </div>
</Studio>
<style>
  .archive{padding-top:67px;padding-bottom:95px}.archive h1{font-size:clamp(37px,5vw,57px);margin:18px 0}.archive>p{max-width:70ch;color:#536577}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:42px}.cards article{background:#fff;border:1px solid #dce4df;border-radius:12px;padding:30px}.cards small{font-size:11px;color:#136d73;font-weight:800}.cards h2{font-size:23px;margin:13px 0}.cards h2 a{text-decoration:none}.cards p{font-size:14px;color:#536577}.cards article>a{font-size:13px;color:#136d73;font-weight:700}@media(max-width:660px){.archive{padding-top:34px}.cards{grid-template-columns:1fr;margin-top:25px}.cards article{padding:22px}}
</style>
