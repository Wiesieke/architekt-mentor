---
import puzzles from '../../../data/puzzles.json';
import PuzzleExercise from '../../components/PuzzleExercise.astro';
export function getStaticPaths(){
  return puzzles.map(p => ({params:{id:p.id},props:{puzzle:p}}));
}
const { puzzle } = Astro.props as { puzzle: (typeof puzzles)[number] };
---
<PuzzleExercise puzzle={puzzle} permanent />
