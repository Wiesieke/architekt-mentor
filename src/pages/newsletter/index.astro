---
import Studio from '../../layouts/Studio.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---
<Studio title="Newsletter: Tydzień z ArchitectMentor" description="Cotygodniowy wybór najważniejszych tekstów, łamigłówek i decyzji architektonicznych. Zapisz się na polską edycję." translationUrl="/en/newsletter/">
  <div class="container newsletter-page"><div class="eyebrow">Newsletter · edycja polska</div><h1>Tydzień z ArchitectMentor</h1><p class="lead">Jeden e-mail tygodniowo: najciekawsza decyzja, łamigłówka i wybrane teksty. Krótko i praktycznie.</p>
    <NewsletterForm locale="pl" />
    <p class="note">Zapis wymaga potwierdzenia e-mailem. W każdej wiadomości znajdziesz link do wypisania się. Adres przechowuje MailerLite; szczegóły w <a href="/informacja-o-danych/">informacji o danych</a>.</p>
    <p><a href="/en/newsletter/" lang="en">English edition →</a></p>
  </div>
</Studio>
<style>.newsletter-page{max-width:850px;padding-top:65px;padding-bottom:100px}.newsletter-page h1{font-size:clamp(36px,5vw,56px);margin:16px 0}.lead{font-size:19px;color:var(--muted);max-width:58ch}.note{font-size:13px;color:var(--muted);margin-top:22px}.newsletter-page a{color:var(--teal)}</style>
