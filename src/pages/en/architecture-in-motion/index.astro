---
import Studio from '../../../layouts/Studio.astro';
import { englishArticles, englishArticleUrl } from '../../../data/articles-en';
const items = englishArticles.filter(article => article.section === 'architecture-in-motion');
const format = (value: string) => new Intl.DateTimeFormat('en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${value}T12:00:00Z`));
---
<Studio locale="en" translationUrl="/architektura-w-ruchu/" title="Architecture in motion" description="Technology developments that matter to IT architecture: verified dates, primary sources and practical design questions.">
  <div class="container archive"><div class="eyebrow">Magazine · technology developments</div><h1>Architecture in motion</h1><p>What changed, when did it happen, and what should you check in your architecture? We separate events from our interpretation of their impact.</p><div class="cards">{items.map(item => <article><div class="meta">{item.topic}{item.eventDate && <> · Event: <time datetime={item.eventDate}>{format(item.eventDate)}</time></>}</div><h2><a href={englishArticleUrl(item)}>{item.title}</a></h2><p>{item.description}</p><a class="read" href={englishArticleUrl(item)}>Read the article →</a></article>)}</div></div>
</Studio>
<style>
  .archive{padding-top:67px;padding-bottom:95px}.archive h1{font-size:clamp(37px,5vw,57px);margin:18px 0}.archive>p{max-width:68ch;color:#536577}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:42px}.cards article{background:#fff;border:1px solid #dce4df;border-radius:12px;padding:30px}.cards .meta{font-size:11px;color:#136d73;font-weight:800}.cards h2{font-size:23px;margin:13px 0}.cards h2 a{text-decoration:none}.cards h2 a:hover{text-decoration:underline}.cards p{font-size:14px;color:#536577}.read{font-size:13px;color:#136d73;font-weight:700}@media(max-width:660px){.archive{padding-top:34px}.cards{grid-template-columns:1fr;margin-top:25px}.cards article{padding:22px}}
</style>
