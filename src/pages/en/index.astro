---
import Studio from '../../layouts/Studio.astro';
import { englishArticles, englishArticleUrl } from '../../data/articles-en';
const latest = englishArticles.find(article => article.slug === 'postgresql-19-beta4')!;
const foundation = englishArticles.find(article => article.slug === 'bulkhead')!;
---
<Studio locale="en" translationUrl="/" title="Practical IT architecture: patterns and decisions" description="ArchitectMentor: a practical magazine on enterprise and solution architecture, technology developments, patterns and decisions." published="2026-09-28">
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">Practical architecture magazine</div><h1>Better architecture begins with <em>better questions.</em></h1><p>Explore architecture decisions, durable patterns and technology developments. Each article connects a concept to a question you can ask in a real project.</p><div class="actions"><a class="button" href="/en/architecture-in-motion/">Explore what changed →</a><a href="/en/foundations/">Learn the foundations →</a></div></div><div class="focus"><small>FEATURED · ARCHITECTURE IN MOTION</small><h2><a href={englishArticleUrl(latest)}>{latest.title}</a></h2><p>{latest.description}</p><a href={englishArticleUrl(latest)}>Read the analysis →</a></div></div></section>
  <section class="container paths"><div class="eyebrow">Two ways to explore</div><h2>From a technology change to an architecture decision</h2><div class="cards"><a href="/en/architecture-in-motion/"><small>01 · DEVELOPMENTS</small><h3>Architecture in motion</h3><p>Verified dates and primary sources, followed by an interpretation and a practical question.</p><span>Browse articles →</span></a><a href="/en/foundations/"><small>02 · FOUNDATIONS</small><h3>Patterns and methods</h3><p>C4, ADR, resilience patterns and frameworks explained through the decisions they support.</p><span>Explore foundations →</span></a></div></section>
  <section class="highlight"><div class="container highlight-grid"><div><div class="eyebrow">Start with a pattern</div><h2>{foundation.title}</h2><p>{foundation.description}</p><a href={englishArticleUrl(foundation)}>Read the article →</a></div><div><div class="eyebrow">About the author</div><h2>Architecture explained in plain language</h2><p>I’m Wiesław Ejsymont. I have worked in solution and enterprise architecture for over 20 years. I created ArchitectMentor to help people ask clearer questions, identify risks and explain their decisions.</p><a href="mailto:architektura@sensinte.com?subject=ArchitectMentor%20enquiry">Get in touch →</a></div></div></section>
</Studio>
<style>
  .hero{background:#142b3b;color:#f8f7f2}.hero-grid{min-height:570px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:70px;padding-top:70px;padding-bottom:80px}.hero h1{font-size:clamp(42px,5vw,68px);line-height:1.09;max-width:13ch;margin:28px 0 22px}.hero h1 em{color:#bce4d2;font-style:normal}.hero p{font-size:18px;max-width:56ch;color:#c9d8d8}.hero .eyebrow{color:#bce4d2}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:28px}.actions>a:not(.button){color:#f8f7f2;font-weight:700}.focus{background:#fff;color:#182637;padding:34px;border-radius:14px}.focus small,.cards small{color:#136d73;font-size:11px;font-weight:800;letter-spacing:.12em}.focus h2{font-size:29px}.focus h2 a{text-decoration:none}.focus p{font-size:15px;color:#536577}.focus>a,.highlight a{color:#136d73;font-weight:800}.paths{padding-top:85px;padding-bottom:90px}.paths h2{font-size:clamp(30px,4vw,44px);max-width:18ch}.cards{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:32px}.cards a{display:block;background:#fff;border:1px solid #dce4df;border-radius:12px;padding:30px;text-decoration:none}.cards h3{font-size:25px}.cards p{color:#536577}.cards span{color:#136d73;font-weight:800}.highlight{background:#e8f4ef;padding:80px 0}.highlight-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.highlight h2{font-size:clamp(26px,3vw,38px)}.highlight p{color:#40566a}@media(max-width:720px){.hero-grid,.cards,.highlight-grid{grid-template-columns:1fr;gap:25px}.hero-grid{padding-top:52px;padding-bottom:60px}.paths,.highlight{padding-top:60px;padding-bottom:60px}.focus,.cards a{padding:22px}}
</style>
