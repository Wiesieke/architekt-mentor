---
import StarterExercises from '../../components/StarterExercises.astro';
import Studio from '../../layouts/Studio.astro';
import { englishArticles, englishArticleUrl } from '../../data/articles-en';
import { latestEnglishPuzzle } from '../../data/puzzles-en';
import { englishAntipatterns } from '../../data/antipatterns-en';
const foundation = englishArticles.find(article => article.slug === 'bulkhead')!;
const todayFoundation = englishArticles.find(article => article.slug === 'asynchronous-notifications')!;
const featuredArticle = englishArticles.filter(article => article.published).sort((a, b) => b.published!.localeCompare(a.published!))[0];
const todayNews = englishArticles.find(article => article.slug === 'github-actions-macos-14-retirement')!;
const todayAntipattern = englishAntipatterns.find(pattern => pattern.id === '2026-10-02-powiadomienie-steruje-transakcja')!;
---
<Studio locale="en" translationUrl="/pl/" title="Practical IT architecture: patterns and decisions" description="ArchitectMentor: a practical magazine on enterprise and solution architecture, exercises, technology developments and decisions." published="2026-10-02">
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">Practical architecture magazine</div><h1>Better architecture begins with <em>better questions.</em></h1><p>Explore architecture decisions, durable patterns and technology developments. Each article connects a concept to a question you can ask in a real project.</p><div class="actions"><a class="button" href="/en/practice/">Try your first architecture decision →</a><a href="#start">See how ArchitectMentor works ↓</a></div></div><div class="focus"><small>LATEST ARTICLE · {featuredArticle.section === 'architecture-with-ai' ? 'ARCHITECT + AI' : featuredArticle.section === 'foundations' ? 'FOUNDATIONS' : 'ARCHITECTURE IN MOTION'}</small><h2><a href={englishArticleUrl(featuredArticle)}>{featuredArticle.title}</a></h2><p>{featuredArticle.description}</p><a href={englishArticleUrl(featuredArticle)}>Read the article →</a></div></div></section>
  <section class="container paths" id="start"><div class="eyebrow">Start here</div><h2>Start with one architecture decision</h2><p class="path-intro">New to ArchitectMentor? Begin with Practice: make a decision before reading the analysis, then follow the links only if you want to go deeper.</p><div class="cards"><a class="featured-path" href="/en/practice/"><small>01 · PRACTICE</small><h3>Make a decision</h3><p>Work through a scenario, answer a mentor question, then compare your reasoning with a senior architect.</p><span>Try an exercise →</span></a><a href="/en/foundations/"><small>02 · LEARN</small><h3>Patterns and methods</h3><p>C4, ADR, resilience patterns and frameworks explained through the decisions they support.</p><span>Explore foundations →</span></a><a href="/en/architecture-in-motion/"><small>03 · FOLLOW CHANGE</small><h3>Architecture in motion</h3><p>Dates and primary sources, followed by an interpretation and a practical question.</p><span>Browse articles →</span></a><a href="/en/tools/"><small>04 · DESIGN</small><h3>Record your decision</h3><p>Draft an ADR locally, or turn a brief into an HLD outline for review.</p><span>Open the tools →</span></a></div></section>
  <section class="weekly" id="latest"><div class="container"><div class="eyebrow">Latest publication · 2 October 2026</div><h2>What did we add today?</h2><p>Four new pieces separate a committed business result from auxiliary work and turn a runner retirement into a concrete migration decision.</p><div class="weekly-grid"><a href="/en/practice/"><small>EXERCISE</small><strong>{latestEnglishPuzzle.title}</strong><span>Quick decision · mentor · senior analysis →</span></a><a href={`/en/anti-patterns/${todayAntipattern.id}/`}><small>ANTI-PATTERN</small><strong>{todayAntipattern.title}</strong><span>Symptoms · consequences · better decision →</span></a><a href={englishArticleUrl(todayFoundation)}><small>FOUNDATIONS · NEW</small><strong>{todayFoundation.title}</strong><span>Durable task · outbox · correct retry →</span></a><a href={englishArticleUrl(todayNews)}><small>ARCHITECTURE IN MOTION · 1 OCT</small><strong>{todayNews.title}</strong><span>Verified announcement · deadline · migration test →</span></a></div></div></section>
  <StarterExercises locale="en" />
  <section class="newsletter-cta"><div class="container"><div><div class="eyebrow">Once a week</div><h2>Useful architecture in your inbox</h2><p>An exercise, selected reading and a short editorial note. One email per week.</p></div><a class="button" href="/en/newsletter/">Subscribe →</a></div></section>
  <section class="highlight"><div class="container highlight-grid"><div><div class="eyebrow">Start with a pattern</div><h2>{foundation.title}</h2><p>{foundation.description}</p><a href={englishArticleUrl(foundation)}>Read the article →</a></div><div><div class="eyebrow">About me</div><h2>Four decades in IT. I still start with questions.</h2><p>I’m Wiesław Ejsymont. I have worked in IT for over 40 years, including more than 20 years in solution and enterprise architecture. I started my career in the era of IBM PC 286 computers. Over the following decades, I kept developing my skills through successive technological shifts — from Solaris servers, networks and programming in assembly, C and Java, through the growth of the internet and increasingly complex systems, to today’s wave of AI. I have seen IT applied in industry, telecommunications and aviation. Over time, I became increasingly interested in how to use evolving technologies to build solutions that serve an entire organisation. New tools are interesting; the consequences of decisions last longer. At ArchitectMentor, I ask about the goal, the risk and how we will know whether a solution works.</p><a href="/en/for-business/">Get in touch →</a></div></div></section>
<section class="container" style="padding-block:35px"><div class="eyebrow">New tutorial series</div><h2>How an architect works with AI</h2><p>From a brief to a reviewed decision: assumptions, alternatives, diagrams and evidence.</p><a class="button" href="/en/architecture-with-ai/">Explore the tutorials →</a></section>
<section class="container" style="padding-block:35px"><div class="eyebrow">Events pilot</div><h2>Worth attending</h2><p>Four selected events: diagrams with AI, architectural decisions, production systems and AI costs.</p><a class="button" href="/en/events/">See the selection →</a></section>
</Studio>
<style>
  .hero{background:#142b3b;color:#f8f7f2}.hero-grid{min-height:570px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:70px;padding-top:70px;padding-bottom:80px}.hero h1{font-size:clamp(42px,5vw,68px);line-height:1.09;max-width:13ch;margin:28px 0 22px}.hero h1 em{color:#bce4d2;font-style:normal}.hero p{font-size:18px;max-width:56ch;color:#c9d8d8}.hero .eyebrow{color:#bce4d2}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:28px}.actions>a:not(.button){color:#f8f7f2;font-weight:700}.focus{background:#fff;color:#182637;padding:34px;border-radius:14px}.focus small,.cards small{color:#136d73;font-size:11px;font-weight:800;letter-spacing:.12em}.focus h2{font-size:29px}.focus h2 a{text-decoration:none}.focus p{font-size:15px;color:#536577}.focus>a,.highlight a{color:#136d73;font-weight:800}.paths{padding-top:85px;padding-bottom:90px;scroll-margin-top:110px}.paths h2,.weekly h2{font-size:clamp(30px,4vw,44px);max-width:18ch}.path-intro{max-width:68ch;color:#536577;margin:0 0 30px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:32px}.cards a{display:block;background:#fff;border:1px solid #dce4df;border-radius:12px;padding:30px;text-decoration:none}.cards a.featured-path{background:#e8f4ef;border-color:#b6d4c9}.cards h3{font-size:25px}.cards p{color:#536577}.cards span{color:#136d73;font-weight:800}.weekly{background:#fff;padding:80px 0}.weekly>div>p{color:#536577;max-width:65ch}.weekly-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:30px}.weekly-grid a{display:flex;flex-direction:column;padding:23px;border:1px solid #dce4df;border-radius:10px;text-decoration:none}.weekly-grid small{color:#136d73;font-size:11px;font-weight:800}.weekly-grid strong{font:700 20px var(--display);margin:9px 0}.weekly-grid span{color:#536577;font-size:13px;margin-top:auto}.newsletter-cta{background:#e8f4ef;padding:50px 0}.newsletter-cta>.container{display:flex;justify-content:space-between;align-items:center;gap:32px}.newsletter-cta h2{font-size:clamp(25px,3vw,36px);margin:9px 0}.newsletter-cta p{margin:0;color:#40566a}.newsletter-cta .button{flex:none}.highlight{background:#e8f4ef;padding:80px 0}.highlight-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.highlight h2{font-size:clamp(26px,3vw,38px)}.highlight p{color:#40566a}@media(max-width:720px){.hero-grid,.cards,.weekly-grid,.highlight-grid{grid-template-columns:1fr;gap:25px}.hero-grid{padding-top:52px;padding-bottom:60px}.paths,.weekly,.highlight{padding-top:60px;padding-bottom:60px}.newsletter-cta>.container{display:block}.newsletter-cta .button{margin-top:24px}.focus,.cards a{padding:22px}}
</style>
