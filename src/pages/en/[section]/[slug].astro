---
import Studio from '../../../layouts/Studio.astro';
import Comments from '../../../components/Comments.astro';
import { englishArticles, englishArticleUrl, polishArticleUrl, type EnglishArticle } from '../../../data/articles-en';

export function getStaticPaths() {
  return englishArticles.map(article => ({params:{section:article.section,slug:article.slug},props:{article}}));
}
const { article } = Astro.props as {article:EnglishArticle};
const sectionTitle = article.section === 'architecture-with-ai' ? 'IT architecture in the age of AI' : article.section === 'foundations' ? 'Architecture foundations' : 'Architecture in motion';
const format = (value: string) => new Intl.DateTimeFormat('en-GB',{dateStyle:'long',timeZone:'UTC'}).format(new Date(`${value}T12:00:00Z`));
const schema = {
  '@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,
  inLanguage:'en',articleSection:sectionTitle,
  mainEntityOfPage:new URL(englishArticleUrl(article),'https://ejsymont.com').href,
  author:{'@type':'Person',name:'Wiesław Ejsymont'},
  ...(article.published ? {datePublished:article.published} : {}),
};
---
<Studio locale="en" translationUrl={polishArticleUrl(article)} title={article.title} description={article.description} published={article.published}>
  <div class="article-page"><div class="container article-wrap"><a class="back" href={`/en/${article.section}/`}>← {sectionTitle}</a><header><div class="eyebrow">{sectionTitle} · {article.topic}</div><h1>{article.title}</h1><p>{article.description}</p><div class="meta">Wiesław Ejsymont {article.published && <> · Published <time datetime={article.published}>{format(article.published)}</time></>}{article.eventDate && <> · Event date <time datetime={article.eventDate}>{format(article.eventDate)}</time></>}</div></header><article class="article-body" set:html={article.body} /><Comments articlePath={englishArticleUrl(article)} locale="en" /><nav class="more" aria-label="Further reading"><a href={`/en/${article.section}/`}>More articles →</a><a href="/en/foundations/">Explore foundations →</a></nav></div></div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g,'\u003c')} />
</Studio>
<style>
  .article-page{padding:55px 0 95px}.article-wrap{max-width:860px}.back{color:#136d73;font-weight:700;font-size:13px}.article-page header{margin:43px 0 31px}.article-page h1{font-size:clamp(34px,5vw,55px);max-width:20ch;margin:18px 0}.article-page header p{color:#536577;font-size:18px;max-width:67ch}.meta{color:#617880;font-size:12px;margin-top:25px}.article-body{background:#fff;border:1px solid #dce4df;border-radius:14px;padding:clamp(22px,5vw,45px)}.article-body :global(pre){overflow-x:auto;white-space:pre;padding:16px;background:#f5f8f5;border-radius:8px;font-size:13px}.article-body :global(table){display:block;overflow-x:auto;max-width:100%;border-collapse:collapse}.article-body :global(td),.article-body :global(th){padding:9px;border:1px solid #dce4df;text-align:left}.article-body :global(p),.article-body :global(li){color:#3d5261;line-height:1.8}.article-body :global(h3){font-size:22px;margin:30px 0 10px}.article-body :global(a){color:#136d73;text-decoration-thickness:2px;text-underline-offset:3px}.article-body :global(.source){border-top:1px solid #dce4df;padding-top:19px;margin-top:32px;font-size:13px}.article-body :global(.example),.article-body :global(.note){background:#e8f4ef;border-radius:9px;padding:17px;margin:23px 0;color:#3d5261}.article-body :global(.grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.article-body :global(.tile){padding:14px;background:#f5f8f5;border-radius:7px}.more{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px}.more a{font-weight:700;color:#136d73}@media(max-width:540px){.article-page{padding:27px 0 60px}.article-page header{margin:26px 0}.article-body :global(.grid){grid-template-columns:1fr}}
</style>
