---
import Studio from '../layouts/Studio.astro';
import puzzles from '../../data/puzzles.json';
import { marked } from 'marked';

const puzzle = [...puzzles].filter(p => p.coach).sort((a,b) => b.date.localeCompare(a.date))[0];
const paragraphs = puzzle.scenario.split(/\n\n+/);
const analysis = marked.parse(puzzle.analysis);
---
<Studio title={puzzle.title} description="Praktyczna łamigłówka architektoniczna: odpowiedz, skorzystaj z pytania mentora i porównaj swoje rozumowanie z analizą." active="practice">
  <div class="exercise-head"><div class="container"><a class="back" href="/">← Wróć do strony głównej</a><div class="head-grid"><div><div class="eyebrow">Ćwiczenie architektoniczne · {puzzle.week}</div><h1>{puzzle.title}</h1><p>Przeczytaj scenariusz, zapisz decyzję i jej uzasadnienie. Mentor może zadać Ci pytanie naprowadzające przed oceną.</p></div><div class="head-aside"><span>CEL ĆWICZENIA</span><strong>Uzasadnij granicę awarii.</strong><small>Szacowany czas: 8–12 minut</small></div></div></div></div>
  <div class="container exercise-grid" data-puzzle-id={puzzle.id}>
    <aside class="sidebar" aria-label="Etapy ćwiczenia"><div class="sidebar-sticky"><div class="sidebar-label">TWOJA ŚCIEŻKA</div><ol><li class="active" id="step-read"><b>1</b><span>Rozpoznaj sytuację<small>Fakty i niewiadome</small></span></li><li id="step-answer"><b>2</b><span>Opisz decyzję<small>Twoje rozumowanie</small></span></li><li id="step-mentor"><b>3</b><span>Sprawdź z mentorem<small>Pytanie i ocena</small></span></li></ol><div class="sidebar-rule">Dobra odpowiedź pokazuje nie tylko <em>co</em> zrobić, ale <em>dlaczego</em> i jak to sprawdzić.</div></div></aside>
    <div class="content">
      <article class="case-block"><div class="block-top"><span class="block-number">01</span><span>SCENARIUSZ</span><span class="difficulty">{puzzle.difficulty}</span></div><div class="case-body"><h2>Co wiemy?</h2>{paragraphs.map(p => <p>{p}</p>)}<div class="question"><span>Pytanie do Ciebie</span><p>{puzzle.question}</p></div><details class="hints"><summary>Zobacz pytania naprowadzające <span aria-hidden="true">＋</span></summary><ul>{puzzle.hints.map(h => <li>{h}</li>)}</ul></details></div></article>
      <section class="answer-block" aria-labelledby="answer-title"><div class="block-top"><span class="block-number">02</span><span>TWOJA DECYZJA</span></div><div class="answer-body"><h2 id="answer-title">Jak Ty byś to rozwiązał?</h2><p>Wpisz decyzję, najważniejszy argument i sposób jej sprawdzenia. Możesz najpierw napisać wersję roboczą.</p><label class="answer-label" for="answer">Twoja odpowiedź</label><textarea id="answer" maxlength="4000" placeholder="Zacząłbym od... ponieważ... Sprawdziłbym to przez..." aria-describedby="answer-help"></textarea><div class="answer-help" id="answer-help"><span id="counter">0 / 4000 znaków</span><span>Minimum 40 znaków do oceny</span></div><div class="privacy"><label><input type="checkbox" id="save-answer" /> Zapisz odpowiedź i ocenę na 90 dni, aby rozwijać narzędzie</label><a href="https://ejsymont.com/informacja-o-danych.html" target="_blank" rel="noopener noreferrer">Jak przetwarzamy dane? ↗</a></div><p class="small-note">Odpowiedź zostanie wysłana do mentora AI w celu przygotowania informacji zwrotnej. Nie wpisuj danych poufnych.</p><div class="answer-actions"><button class="button" id="coach-button" type="button">Sprawdź odpowiedź <span aria-hidden="true">→</span></button><span id="coach-status" role="status" aria-live="polite"></span></div><div id="coach-result" aria-live="polite"></div></div></section>
      <section class="analysis-block" aria-labelledby="analysis-title"><div class="block-top"><span class="block-number">03</span><span>ANALIZA SENIORA</span></div><div class="analysis-intro"><div><h2 id="analysis-title">Porównaj tok rozumowania</h2><p>Pełna analiza jest dostępna również bez oceny AI.</p></div><button class="button secondary" id="reveal" type="button" aria-expanded="false" aria-controls="analysis">Pokaż analizę <span aria-hidden="true">↓</span></button></div><div class="analysis-content" id="analysis" hidden set:html={analysis} /></section>
      <div class="further"><span>NASTĘPNY KROK</span><p>Po ćwiczeniu przeczytaj o <a href="https://ejsymont.com/podstawy-architektury.html#bulkhead">wzorcu bulkhead</a> i <a href="https://ejsymont.com/antywzorce.html">antywzorcach</a>.</p></div>
    </div>
  </div>
</Studio>

<script>
  const root = document.querySelector<HTMLElement>('[data-puzzle-id]');
  const answer = document.querySelector<HTMLTextAreaElement>('#answer');
  const button = document.querySelector<HTMLButtonElement>('#coach-button');
  const result = document.querySelector<HTMLElement>('#coach-result');
  const status = document.querySelector<HTMLElement>('#coach-status');
  const counter = document.querySelector<HTMLElement>('#counter');
  const reveal = document.querySelector<HTMLButtonElement>('#reveal');
  const analysis = document.querySelector<HTMLElement>('#analysis');
  const save = document.querySelector<HTMLInputElement>('#save-answer');
  let stage: 'hint' | 'score' = 'hint';
  let attemptId: string | null = null;
  const markStep = (id: string) => document.querySelector('#'+id)?.classList.add('active');
  answer?.addEventListener('focus', () => markStep('step-answer'));
  answer?.addEventListener('input', () => { if(counter && answer) counter.textContent = `${answer.value.length} / 4000 znaków`; });
  reveal?.addEventListener('click', () => {
    if(!reveal || !analysis) return;
    const open = reveal.getAttribute('aria-expanded') !== 'true';
    reveal.setAttribute('aria-expanded', String(open));
    analysis.hidden = !open;
    reveal.textContent = open ? 'Ukryj analizę ↑' : 'Pokaż analizę ↓';
  });
  function para(text: string, cls?: string){ const p=document.createElement('p');p.textContent=text;if(cls)p.className=cls;return p; }
  button?.addEventListener('click', async () => {
    if(!button || !answer || !status || !result || !root) return;
    const value=answer.value.trim();
    if(value.length<40){status.textContent='Opisz decyzję trochę szerzej — minimum 40 znaków.';answer.focus();return;}
    button.disabled=true;button.textContent=stage==='hint'?'Mentor przygotowuje pytanie…':'Mentor ocenia odpowiedź…';status.textContent='';
    try{
      const response=await fetch('/api/evaluate-puzzle',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({puzzleId:root.dataset.puzzleId,stage,answer:value,attemptId,saveAnswer:save?.checked===true})});
      const data=await response.json();
      if(!response.ok)throw new Error(data.error||'Ocena chwilowo niedostępna.');
      attemptId=data.attemptId||attemptId;
      result.replaceChildren();markStep('step-mentor');
      const card=document.createElement('div');card.className='feedback';
      if(stage==='hint'){
        card.append(para('PYTANIE MENTORA','feedback-label'),para(data.positive||''),para(data.question||'','feedback-question'));
        result.append(card);status.textContent='Uzupełnij odpowiedź powyżej, a potem sprawdź ocenę.';
        button.textContent='Oceń poprawioną odpowiedź →';stage='score';answer.focus();
      }else{
        card.append(para('OCENA POMOCNICZA','feedback-label'),para(`${data.score ?? '?'} / ${data.maxScore ?? '?'} punktów`,'feedback-score'),para(data.overall||''));
        if(Array.isArray(data.criteria)){const list=document.createElement('ul');for(const c of data.criteria){const li=document.createElement('li');li.textContent=`${c.label}: ${c.points}/2 — ${c.reason}`;list.append(li)}card.append(list)}
        card.append(para(data.nextStep||''));result.append(card);button.remove();status.textContent='Porównaj swoją odpowiedź z pełną analizą poniżej.';
      }
      if(data.saved===true)status.textContent+=` Zapisano (ID: ${data.recordId}).`;
      if(data.saved===false)status.textContent+=' Zapis nie powiódł się; zachowaj odpowiedź u siebie.';
    }catch(error){status.textContent=error instanceof Error?error.message:'Ocena chwilowo niedostępna.';button.textContent=stage==='hint'?'Sprawdź odpowiedź →':'Oceń poprawioną odpowiedź →';}
    finally{button.disabled=false;}
  });
</script>

<style>
  .exercise-head{background:#142b3b;color:#f8f7f2;padding:35px 0 62px}.back{font-size:12px;font-weight:700;text-decoration:none;color:#bed6d7}.back:hover{text-decoration:underline}.head-grid{display:grid;grid-template-columns:1fr 235px;align-items:end;gap:80px;margin-top:53px}.exercise-head .eyebrow{color:#bce4d2}.exercise-head h1{font-size:clamp(33px,4.4vw,55px);max-width:17ch;margin:18px 0}.exercise-head p{max-width:67ch;color:#c5d8d8;margin:0}.head-aside{border-left:2px solid #5e8890;padding-left:21px}.head-aside span,.head-aside strong,.head-aside small{display:block}.head-aside span{font-size:10px;letter-spacing:.15em;color:#bce4d2;font-weight:800}.head-aside strong{font:700 21px/1.3 var(--display);margin:9px 0}.head-aside small{color:#acc6c8}.exercise-grid{display:grid;grid-template-columns:220px minmax(0,760px);gap:55px;padding-top:56px;padding-bottom:88px}.sidebar-sticky{position:sticky;top:126px}.sidebar-label{font-size:11px;letter-spacing:.14em;font-weight:800;color:#748995}.sidebar ol{padding:0;margin:22px 0 0;list-style:none}.sidebar li{display:flex;gap:12px;align-items:start;padding:0 0 26px;position:relative;color:#82929b}.sidebar li:not(:last-child):after{content:'';position:absolute;left:13px;top:30px;bottom:2px;border-left:1px solid #cdd9d6}.sidebar li.active{color:#136d73}.sidebar b{flex:none;display:grid;place-items:center;border-radius:50%;border:1px solid #c9d7d2;width:28px;height:28px;background:#f8f7f2;font-size:11px}.sidebar li.active b{background:#136d73;border-color:#136d73;color:#fff}.sidebar li span{font-weight:700;font-size:13px}.sidebar li small{display:block;font-weight:400;color:#7c8d98;font-size:11px;margin-top:1px}.sidebar-rule{background:#e8f4ef;border-radius:10px;color:#405c61;font-size:12px;line-height:1.6;padding:18px;margin-top:10px}.content{min-width:0}.case-block,.answer-block,.analysis-block{border:1px solid #dce4df;border-radius:14px;background:#fff;overflow:hidden;margin-bottom:21px}.block-top{display:flex;align-items:center;gap:11px;border-bottom:1px solid #e8ede8;padding:15px 28px;color:#617880;font-size:11px;font-weight:800;letter-spacing:.13em}.block-number{display:grid;place-items:center;width:25px;height:25px;background:#e8f4ef;border-radius:6px;color:#136d73;letter-spacing:0}.difficulty{margin-left:auto;border-radius:18px;padding:4px 10px;background:#f4f5ee;letter-spacing:0;color:#46636e}.case-body,.answer-body{padding:27px 32px 33px}.case-body h2,.answer-body h2,.analysis-intro h2{font-size:25px;margin:0 0 16px}.case-body>p{color:#3d5261;line-height:1.78;margin:0 0 18px}.question{border-left:3px solid #e1a35d;background:#fbf7eb;padding:15px 20px;margin:27px 0}.question span{font-size:10px;font-weight:800;letter-spacing:.13em;color:#85602f}.question p{font-weight:700;margin:6px 0 0;line-height:1.55}.hints{border-top:1px solid #e8ede8;padding-top:15px}.hints summary{cursor:pointer;color:#136d73;font-size:13px;font-weight:800;list-style:none}.hints summary::-webkit-details-marker{display:none}.hints summary span{float:right;font-size:19px;font-weight:400}.hints ul{color:#536577;font-size:13px;padding-left:19px;line-height:1.6}.hints li{margin:9px 0}.answer-body>p{color:#536577;font-size:14px}.answer-label{display:block;margin-top:24px;margin-bottom:8px;font-size:13px;font-weight:800}.answer-body textarea{width:100%;height:195px;resize:vertical;padding:16px;border:1px solid #c9d8d4;border-radius:9px;background:#fefefd;color:#182637;line-height:1.6}.answer-help{display:flex;justify-content:space-between;gap:10px;color:#778994;font-size:11px}.privacy{margin-top:24px;padding:15px;background:#f5f8f5;border-radius:8px;font-size:12px}.privacy label{display:flex;gap:8px;align-items:start}.privacy input{margin:3px 0 0}.privacy a{display:inline-block;color:#136d73;margin:5px 0 0 21px}.answer-body p.small-note{margin:14px 0 0;font-size:11px}.answer-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:22px}.answer-actions .button:disabled{opacity:.65;cursor:wait}#coach-status{font-size:12px;color:#536577}.feedback{background:#e8f4ef;border:1px solid #bddbd2;border-radius:10px;margin-top:24px;padding:22px}.feedback p{font-size:14px}.feedback .feedback-label{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}.feedback .feedback-question{font-weight:800;font-size:16px}.feedback .feedback-score{font:800 24px var(--display);color:#136d73}.feedback li{font-size:13px;margin:10px 0}.analysis-intro{padding:26px 32px;display:flex;justify-content:space-between;align-items:center;gap:20px}.analysis-intro h2{margin-bottom:5px}.analysis-intro p{color:#536577;font-size:13px;margin:0}.analysis-intro .button{font-size:12px;white-space:nowrap}.analysis-content{padding:0 32px 30px;border-top:1px solid #e8ede8;color:#3e5360}.analysis-content :global(h3){font-size:19px;margin:28px 0 7px}.analysis-content :global(p),.analysis-content :global(li){font-size:14px;line-height:1.7}.analysis-content :global(ul),.analysis-content :global(ol){padding-left:21px}.analysis-content :global(blockquote){border-left:3px solid #e1a35d;padding:8px 15px;background:#fbf7eb;margin-left:0}.further{padding:17px 4px;color:#536577}.further span{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}.further p{margin:7px 0}.further a{color:#136d73;font-weight:700}
  #coach-result :global(.feedback){background:#e8f4ef;border:1px solid #bddbd2;border-radius:10px;margin-top:24px;padding:22px}#coach-result :global(.feedback p){font-size:14px}#coach-result :global(.feedback .feedback-label){font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}#coach-result :global(.feedback .feedback-question){font-weight:800;font-size:16px}#coach-result :global(.feedback .feedback-score){font:800 24px var(--display);color:#136d73}#coach-result :global(.feedback li){font-size:13px;margin:10px 0}
  @media(max-width:850px){.exercise-grid{grid-template-columns:1fr;gap:20px}.sidebar{display:none}.head-grid{grid-template-columns:1fr;gap:24px}.head-aside{max-width:360px}}
  @media(max-width:540px){.exercise-head{padding-bottom:45px}.head-grid{margin-top:33px}.exercise-grid{padding-top:25px;padding-bottom:55px}.block-top{padding:12px 19px}.case-body,.answer-body,.analysis-intro{padding:21px}.analysis-intro{display:block}.analysis-intro .button{margin-top:15px}.analysis-content{padding:0 21px 22px}}
</style>
