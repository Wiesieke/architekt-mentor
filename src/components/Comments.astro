---
interface Props { articlePath: string; locale?: 'pl' | 'en' }
const { articlePath, locale = 'pl' } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const en = locale === 'en';
---
{siteKey && <section class="comments" aria-labelledby="comments-title" data-article={articlePath} data-locale={locale}>
  <h2 id="comments-title">{en ? 'Discuss this article' : 'Porozmawiajmy o tym artykule'}</h2>
  <p>{en ? 'Share a constructive observation or an anonymised example. Comments are checked by AI before publication. Uncertain cases go to the moderator.' : 'Podziel się uwagą lub zanonimizowanym przykładem. Komentarze sprawdza AI przed publikacją. Niejednoznaczne przypadki trafiają do moderatora.'}</p>
  <div class="comment-list" aria-live="polite"></div>
  <form class="comment-form">
    <label>{en ? 'Display name' : 'Nazwa wyświetlana'}<input name="name" required minlength="2" maxlength="80" autocomplete="name" /></label>
    <label>{en ? 'Email (not shown publicly)' : 'E-mail (niewidoczny publicznie)'}<input name="email" required type="email" maxlength="254" autocomplete="email" /></label>
    <label>{en ? 'Comment' : 'Komentarz'}<textarea name="message" required minlength="10" maxlength="2500" rows="5"></textarea></label>
    <label class="trap" aria-hidden="true">Website<input name="website" autocomplete="off" tabindex="-1" /></label>
    <div class="cf-turnstile" data-sitekey={siteKey}></div>
    <p class="rules">{en ? 'Discuss ideas, not people. Do not include confidential details or personal data. By submitting, you accept the ' : 'Oceniaj pomysły, nie osoby. Nie podawaj informacji poufnych ani danych innych osób. Przed wysłaniem przeczytaj '}<a href={en ? '/en/data-notice/' : '/informacja-o-danych/'}>{en ? 'data notice' : 'informację o danych'}</a>.</p>
    <button type="submit">{en ? 'Send comment' : 'Wyślij komentarz'}</button>
    <p class="form-status" role="status"></p>
  </form>
</section>}
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  for (const section of document.querySelectorAll<HTMLElement>('.comments')) {
    const path = section.dataset.article, locale = section.dataset.locale;
    const list = section.querySelector<HTMLElement>('.comment-list');
    if (!list || !path || !locale) continue;
    let listVersion = 0;
    const renderComment = (item: { id: string; display_name: string; body: string }) => {
      const article = document.createElement('article');
      article.dataset.commentId = item.id;
      article.tabIndex = -1;
      const name = document.createElement('strong'), body = document.createElement('p');
      name.textContent = item.display_name; body.textContent = item.body;
      article.append(name, body);
      return article;
    };
    const loadComments = async () => {
      const version = listVersion;
      try {
        const response = await fetch('/api/comments?article=' + encodeURIComponent(path) + '&locale=' + locale, { cache: 'no-store' });
        if (!response.ok) throw new Error('Comments unavailable');
        const { comments } = await response.json();
        if (version !== listVersion) return;
        list.replaceChildren();
        if (!comments.length) { list.textContent = locale === 'en' ? 'No comments yet.' : 'Nie ma jeszcze komentarzy.'; return; }
        for (const item of comments) list.append(renderComment(item));
      } catch {
        if (version === listVersion) list.textContent = locale === 'en' ? 'Comments are temporarily unavailable.' : 'Komentarze są chwilowo niedostępne.';
      }
    };
    loadComments();
    const form = section.querySelector<HTMLFormElement>('form');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.form-status');
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!status || !button) return;
      const fields = new FormData(form);
      const token = fields.get('cf-turnstile-response');
      status.textContent = locale === 'en' ? 'Saving and checking your comment…' : 'Zapisujemy i sprawdzamy komentarz…'; button.disabled = true;
      try {
        const response = await fetch('/api/comments', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ articlePath: path, locale, name: fields.get('name'), email: fields.get('email'),
            message: fields.get('message'), website: fields.get('website'), turnstileToken: token })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Error');
        status.textContent = result.status === 'approved'
          ? (locale === 'en' ? 'Your comment has been published.' : 'Komentarz został opublikowany.')
          : result.status === 'rejected'
            ? (locale === 'en' ? 'Your comment was not published under our discussion rules. Edit the text and try again.' : 'Komentarz nie został opublikowany ze względu na zasady dyskusji. Popraw tekst i spróbuj ponownie.')
            : (locale === 'en' ? 'Your comment has been saved for moderator review. No email confirmation is needed.' : 'Komentarz zapisany i czeka na decyzję moderatora. Nie musisz potwierdzać e-maila.');
        if (result.status === 'approved' && result.comment) {
          // The server supplies this only after confirming publication in the database.
          // Invalidate the initial list request so a stale response cannot erase this comment.
          listVersion++;
          if (!list.querySelector('article')) list.replaceChildren();
          const published = renderComment(result.comment);
          list.prepend(published);
          form.reset();
          published.scrollIntoView({ block: 'start', behavior: 'instant' });
          published.focus({ preventScroll: true });
        } else if (result.status === 'approved') {
          await loadComments();
          form.reset();
        } else if (result.status === 'pending') {
          form.reset();
        }
        // Keep rejected text so the reader can edit it rather than retype it.
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Error';
      } finally {
        button.disabled = false;
        (window as Window & { turnstile?: { reset(): void } }).turnstile?.reset();
      }
    });
  }
</script>
<style>
  .comments{border-top:1px solid var(--line);margin-top:46px;padding-top:30px}.comments h2{font-size:26px}.comments>p{color:var(--muted)}
  .comment-list article{background:white;border:1px solid var(--line);border-radius:9px;padding:16px;margin:12px 0;overflow-wrap:anywhere}
  .comment-list article{scroll-margin-top:110px}.comment-list article:focus-visible{outline:2px solid var(--teal);outline-offset:4px}
  .comment-list article p{white-space:pre-wrap;margin:8px 0 0}.comment-form{display:grid;gap:15px;margin-top:25px}
  .comment-form label{display:grid;gap:5px;font-size:14px;font-weight:700}.comment-form input,.comment-form textarea{width:100%;padding:10px 12px;border:1px solid #b4c6c8;border-radius:7px;background:white}
  .comment-form button{justify-self:start;border:0;border-radius:8px;background:var(--teal);color:white;font-weight:700;padding:12px 18px}.comment-form button:disabled{opacity:.5}
  .comment-form .trap{position:absolute;left:-9999px}.rules{font-size:13px;color:var(--muted);margin:0}.rules a{color:var(--teal)}.form-status{font-weight:700}
</style>
