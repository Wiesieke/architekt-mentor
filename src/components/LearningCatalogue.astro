---
import Studio from '../layouts/Studio.astro';
import { learningCatalogue } from '../data/learning';
interface Props { locale: 'pl' | 'en' }
const { locale } = Astro.props;
const { rows, groups } = learningCatalogue(locale);
const copy = locale === 'pl' ? {
 title: 'Podstawy architektury', description: 'Praktyczne podstawy architektury: integracja, odporność, analiza, bezpieczeństwo, jakość i modele.',
 eyebrow: 'Ucz się · wiedza trwała', intro: 'Wybierz obszar lub znajdź temat. W każdej grupie najnowsze artykuły są na początku.',
 latest: 'Najnowszy artykuł', search: 'Szukaj w tytułach, opisach i tematach', placeholder: 'np. API, ponowienie, C4',
 group: 'Obszar', all: 'Wszystkie obszary', count: 'Znalezione artykuły', empty: 'Brak pasujących artykułów. Spróbuj innego hasła lub obszaru.', reset: 'Wyczyść filtry', read: 'Przeczytaj →',
} : {
 title: 'Architecture foundations', description: 'Practical architecture foundations: integration, resilience, analysis, security, quality and models.',
 eyebrow: 'Learn · durable knowledge', intro: 'Choose an area or find a topic. Each group lists the newest articles first.',
 latest: 'Latest article', search: 'Search titles, descriptions and topics', placeholder: 'e.g. API, retries, C4',
 group: 'Area', all: 'All areas', count: 'Matching articles', empty: 'No matching articles. Try another term or area.', reset: 'Clear filters', read: 'Read →',
};
const dateLabel = (date: string) => new Intl.DateTimeFormat(locale, {day:'numeric', month:'long', year:'numeric', timeZone:'UTC'}).format(new Date(`${date}T12:00:00Z`));
---
<Studio locale={locale} title={copy.title} description={copy.description} translationUrl={locale === 'pl' ? '/en/foundations/' : '/podstawy-architektury/'}>
 <div class="container catalogue" data-learning-catalogue>
  <div class="eyebrow">{copy.eyebrow}</div><h1>{copy.title}</h1><p class="intro">{copy.intro}</p>
  <aside class="latest"><span>{copy.latest} · <time datetime={rows[0].published}>{dateLabel(rows[0].published)}</time></span><a href={rows[0].href}>{rows[0].title} →</a></aside>
  <form class="filters" role="search" hidden>
   <label class="search">{copy.search}<input type="search" name="q" placeholder={copy.placeholder} autocomplete="off" /></label>
   <label>{copy.group}<select name="group"><option value="">{copy.all}</option>{groups.map(g => <option value={g.id}>{g.title} ({g.items.length})</option>)}</select></label>
   <button type="reset">{copy.reset}</button>
  </form>
  <p class="result-count" role="status" aria-live="polite" hidden>{copy.count}: <span data-count>{rows.length}</span></p>
  <p class="empty" hidden>{copy.empty}</p>
  {groups.map(g => <section class="learning-group" data-group={g.id} aria-labelledby={`group-${g.id}`}>
   <h2 id={`group-${g.id}`}>{g.title} <span class="group-count">({g.items.length})</span></h2>
   <div class="cards">{g.items.map(item => <article data-learning-card data-search={`${item.title} ${item.description} ${item.topic} ${g.title}`}>
    <div class="meta"><span>{item.topic}</span>{item.published && <time datetime={item.published}>{dateLabel(item.published)}</time>}</div>
    <h3><a href={item.href}>{item.title}</a></h3><p>{item.description}</p><a class="read" href={item.href}>{copy.read}</a>
   </article>)}</div>
  </section>)}
 </div>
</Studio>
<script>
 document.querySelectorAll<HTMLElement>('[data-learning-catalogue]').forEach(root => {
  const form = root.querySelector<HTMLFormElement>('form')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const select = form.querySelector<HTMLSelectElement>('select')!;
  const status = root.querySelector<HTMLElement>('.result-count')!;
  const empty = root.querySelector<HTMLElement>('.empty')!;
  const normalize = (value: string) => value.toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/g, 'l');
  const update = () => {
   const terms = normalize(input.value).trim().split(/\s+/).filter(Boolean);
   let total = 0;
   root.querySelectorAll<HTMLElement>('[data-group]').forEach(group => {
    let count = 0;
    group.querySelectorAll<HTMLElement>('[data-learning-card]').forEach(card => {
     const match = (!select.value || group.dataset.group === select.value) && terms.every(term => normalize(card.dataset.search ?? '').includes(term));
     card.hidden = !match;
     if (match) count++;
    });
    group.hidden = count === 0;
    group.querySelector('.group-count')!.textContent = `(${count})`;
    total += count;
   });
   status.querySelector('[data-count]')!.textContent = String(total);
   empty.hidden = total > 0;
   root.querySelector<HTMLElement>('.latest')!.hidden = !!select.value || terms.length > 0;
  };
  form.hidden = false; status.hidden = false;
  form.addEventListener('submit', event => event.preventDefault());
  input.addEventListener('input', update); select.addEventListener('change', update);
  form.addEventListener('reset', () => { input.value = ''; select.value = ''; update(); });
 });
</script>
<style>
 [hidden]{display:none!important}.catalogue{padding-top:60px;padding-bottom:90px}.catalogue h1{font-size:clamp(34px,5vw,54px);margin:18px 0}.intro{max-width:68ch;color:#536577}.latest{margin:28px 0;padding:22px;border-left:4px solid #136d73;background:#eaf2ef;border-radius:8px}.latest span{display:block;font-size:13px;color:#536577;margin-bottom:8px}.latest a{font-size:20px;font-weight:800;text-decoration:none}.filters{display:flex;align-items:end;gap:16px;padding:22px;background:#fff;border:1px solid #dce4df;border-radius:12px}.filters label{display:flex;flex-direction:column;gap:8px;font-weight:700;font-size:14px;min-width:0}.search{flex:1}.filters input,.filters select{font:inherit;font-weight:400;border:1px solid #829b9c;border-radius:6px;padding:12px;background:#fff;min-width:0;width:100%;box-sizing:border-box}.filters button{font:inherit;border:1px solid #136d73;border-radius:6px;padding:12px;color:#136d73;background:#fff;cursor:pointer;white-space:nowrap}.result-count{font-size:14px;color:#536577}.learning-group{margin-top:38px}.learning-group h2{font-size:25px}.group-count{font-size:16px;color:#536577;font-weight:400}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.cards article{padding:26px;background:#fff;border:1px solid #dce4df;border-radius:12px;min-width:0}.meta{display:flex;gap:8px;justify-content:space-between;flex-wrap:wrap;font-size:12px;color:#136d73}.meta time{color:#536577}.cards h3{font-size:22px}.cards h3 a{text-decoration:none}.cards p{color:#536577}.read{color:#136d73;font-weight:700}a,input,select,button{overflow-wrap:anywhere}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid #136d73;outline-offset:3px}@media(max-width:700px){.catalogue{padding-top:32px}.cards{grid-template-columns:1fr}.filters{flex-direction:column;align-items:stretch}.cards article{padding:22px}}
</style>
