---
import Studio from '../layouts/Studio.astro';

interface WeeklyPage {
  title:string; description:string; lead:string; meta:string; cta:string;
  editorialTitle:string; editorialParagraphs:string[];
  items:{label:string;title:string;description:string;href:string}[];
  discussionTitle:string; discussionIntro:string; questions:string[][];
  eventsText:string; eventsCta:string;
}
interface WeeklyData {
  date:string; period:string; paths:{pl:string;en:string};
  pages:{pl:WeeklyPage;en:WeeklyPage};
}
interface Props { locale:'pl'|'en'; issue:WeeklyData }
const {locale,issue}=Astro.props;
const en=locale==='en';
const page=issue.pages[locale];
const other=en?'pl':'en';
---
<Studio locale={locale} title={`ArchitectMentor Weekly · ${page.title}`} description={page.description} translationUrl={issue.paths[other]} published={issue.date} modified={issue.date}>
  <section class="opening"><div class="container">
    <div class="eyebrow">ArchitectMentor Weekly · {issue.period}</div>
    <h1>{page.title}</h1><p class="lead">{page.lead}</p><p class="meta">{page.meta}</p>
    <a class="button" href={page.items[0].href}>{page.cta}</a>
  </div></section>
  <div class="container issue">
    <section class="editorial"><div class="eyebrow">{en?'From the editor':'Od redakcji'}</div><h2>{page.editorialTitle}</h2>{page.editorialParagraphs.map(text=><p>{text}</p>)}</section>
    <section aria-labelledby="contents"><div class="eyebrow">{en?'Reading order':'Kolejność lektury'}</div><h2 id="contents">{en?'In this edition':'W tym wydaniu'}</h2>
      <ol class="contents">{page.items.map((item,i)=><li><a href={item.href}><small>{String(i+1).padStart(2,'0')} · {item.label}</small><h3>{item.title}</h3><p>{item.description}</p><span>{en?'Read the material →':'Otwórz materiał →'}</span></a></li>)}</ol>
    </section>
    <section class="discussion"><div class="eyebrow">{en?'Team discussion':'Dyskusja zespołu'}</div><h2>{page.discussionTitle}</h2><p>{page.discussionIntro}</p>{page.questions.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
    <section class="events"><div class="eyebrow">{en?'Conferences and workshops':'Konferencje i warsztaty'}</div><h2>{en?'Continue the discussion with practitioners':'Kontynuuj rozmowę z praktykami'}</h2><p>{page.eventsText}</p><a class="button" href={en?'/en/events/':'/wydarzenia/'}>{page.eventsCta}</a></section>
  </div>
</Studio>
<style>
.opening{background:#142b3b;color:#f8f7f2;padding:64px 0}.opening .eyebrow{color:#bce4d2}.opening h1{font-size:clamp(36px,5vw,60px);line-height:1.12;max-width:18ch}.lead{font-size:20px;max-width:65ch;color:#d9e7e3}.meta{color:#bce4d2;font-size:14px;margin-block:24px}.issue{padding-block:48px}.issue section{margin-bottom:64px}.editorial{max-width:78ch}.issue h2{font-size:clamp(26px,3.5vw,38px)}.contents{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.contents li:last-child{grid-column:1/-1}.contents a{display:block;height:100%;box-sizing:border-box;background:white;border:1px solid #dce4df;border-radius:12px;padding:28px;text-decoration:none}.contents small{color:#136d73;font-weight:800}.contents h3{font-size:23px;line-height:1.35}.contents p{color:#536577}.contents span{color:#136d73;font-weight:700}.discussion,.events{background:#e8f4ef;border-radius:12px;padding:32px}.discussion details{border-top:1px solid #b6d4c9;padding:18px 0}.discussion summary{cursor:pointer;font-weight:700}.discussion details p,.events p{max-width:75ch}@media(max-width:720px){.opening{padding:40px 0}.contents{grid-template-columns:1fr}.contents li:last-child{grid-column:auto}.contents a,.discussion,.events{padding:22px}.lead{font-size:18px}}
</style>
