---
import starters from '../../data/starter-exercises.json';
const { locale='pl' }=Astro.props;
const en=locale==='en';
---
<section class="starter-set" aria-labelledby="starter-title"><div class="container"><div class="eyebrow">{en?'Start here':'Zacznij tutaj'}</div><h2 id="starter-title">{en?'Three decisions. Two ways to practise.':'Trzy decyzje. Dwa sposoby ćwiczenia.'}</h2><p>{en?'Choose a quick answer with an explanation, or develop your reasoning with the mentor. Easy and intermediate exercises.':'Wybierz szybką odpowiedź z wyjaśnieniem albo rozwiń uzasadnienie z mentorem. Ćwiczenia łatwe i średnie.'}</p><div class="starter-cards">{starters.map((item)=>{const v=en?item.en:item.pl;const href=en?`/en/practice/${item.id}/`:`/lamiglowki/${item.id}/`;return <article><small>{v.difficulty} · {en?'2 min or mentor':'2 min lub mentor'}</small><h3><a href={href}>{v.title}</a></h3><p>{v.goal}</p><a href={href}>{en?'Try this decision →':'Przećwicz decyzję →'}</a></article>})}</div></div></section>
<style>.starter-set{padding:42px 0;background:#e8f4ef}.starter-set h2{font-size:clamp(25px,3vw,35px);margin:12px 0}.starter-set>.container>p{max-width:70ch;color:#536577}.starter-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:25px}.starter-cards article{background:white;border:1px solid #bddbd2;border-radius:12px;padding:23px}.starter-cards small{font-size:12px;color:#136d73;font-weight:700}.starter-cards h3{font-size:21px;line-height:1.4}.starter-cards h3 a{text-decoration:none}.starter-cards p{font-size:14px;color:#536577}.starter-cards article>a{font-size:13px;color:#136d73;font-weight:700}@media(max-width:760px){.starter-cards{grid-template-columns:1fr}}</style>
