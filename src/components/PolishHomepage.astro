---
import Studio from '../layouts/Studio.astro';
import { editions, latestEditionDate } from '../data/editions';
import SponsorSlot from './SponsorSlot.astro';
import { articles, articleUrl } from '../data/articles';
import puzzles from '../../data/puzzles.json';

const featuredArticle = articles.filter(article => article.published).sort((a, b) => b.published!.localeCompare(a.published!))[0];
const latestPuzzle = [...puzzles].filter(puzzle => puzzle.coach).sort((a, b) => b.date.localeCompare(a.date))[0];
const editionStart = new Date(`${latestEditionDate}T12:00:00Z`);
const formatDate = (date: Date) => new Intl.DateTimeFormat('pl-PL', { day: '2-digit', month: '2-digit', timeZone: 'UTC' }).format(date);
const currentEditionCount = editions.filter(item => item.published === latestEditionDate).length;
---
<Studio title="Architektura IT w praktyce: ćwiczenia, wzorce i decyzje" description="Magazyn architektury IT i architektury korporacyjnej. Praktyczne łamigłówki, antywzorce, podstawy i analizy zmian technologicznych." modified={latestEditionDate} showEdition translationUrl="/en/">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-label"><span class="pulse"></span> Magazyn architektury IT</div>
        <h1>Lepsza architektura zaczyna się od <em>lepszych pytań.</em></h1>
        <p>Architektura korporacyjna i architektura rozwiązań w praktyce. Ćwicz decyzje na konkretnych scenariuszach, poznawaj wzorce i sprawdzaj, co zmienia się w technologiach.</p>
        <a class="hero-latest" href={articleUrl(featuredArticle)}><span>NAJNOWSZY ARTYKUŁ · {featuredArticle.section === 'podstawy-architektury' ? 'PODSTAWY' : 'W RUCHU'}</span><strong>{featuredArticle.title}</strong><b aria-hidden="true">↗</b></a>
        <div class="hero-actions"><a class="button warm" href="/lamiglowka/">Rozwiąż łamigłówkę <span aria-hidden="true">↗</span></a><a class="hero-link" href="#sciezki">Poznaj ścieżki <span aria-hidden="true">↓</span></a></div>
        <div class="hero-trust"><span>01&nbsp; Praktyczne scenariusze</span><span>02&nbsp; Ocena według kryteriów</span><span>03&nbsp; Wiedza do zastosowania</span></div>
      </div>
      <div class="hero-workspace" aria-label="Przykład toku myślenia architekta">
        <div class="workspace-head"><span class="tiny-mark">AM</span><span>STUDIO DECYZJI</span><span class="work-label">WARSZTAT 01</span></div>
        <div class="workspace-body">
          <div class="case-meta"><span class="signal"></span> Pytanie architektoniczne <span class="case-count">01 / 03</span></div>
          <h2>{latestPuzzle.title}</h2>
          <div class="work-step"><span>01</span><div><strong>Rozpoznaj ryzyko</strong><small>Znajdź wspólną granicę awarii.</small></div></div>
          <div class="work-step"><span>02</span><div><strong>Uzasadnij decyzję</strong><small>Wybierz kompromis, który potrafisz obronić.</small></div></div>
          <div class="work-step muted-step"><span>03</span><div><strong>Porównaj z analizą</strong><small>Zobacz, czego zabrakło w odpowiedzi.</small></div></div>
        </div>
        <div class="workspace-foot"><span class="avatars" aria-hidden="true"><b>?</b><b>✓</b></span><span>Myślenie przed technologią</span><a href="/lamiglowka/" aria-label="Otwórz łamigłówkę">→</a></div>
      </div>
    </div>
  </section>

  <section class="pathways" id="sciezki"><div class="container">
    <div class="section-top"><div><div class="eyebrow">Wybierz swój punkt startu</div><h2>Trzy sposoby pracy<br />z architekturą</h2></div><p>Zacznij od problemu, który masz dziś. Każda ścieżka prowadzi od pytania do świadomej decyzji.</p></div>
    <div class="path-grid">
      <a class="path-card featured" href="/lamiglowka/"><span class="path-index">01 / ĆWICZ</span><span class="path-icon" aria-hidden="true">↗</span><h3>Podejmij decyzję</h3><p>Krótki scenariusz, Twoja odpowiedź i pytanie naprowadzające. Sprawdź rozumowanie według jawnych kryteriów.</p><span class="path-action">Otwórz łamigłówkę <b aria-hidden="true">→</b></span></a>
      <a class="path-card" href="/podstawy-architektury/"><span class="path-index">02 / UCZ SIĘ</span><span class="path-icon" aria-hidden="true">⌁</span><h3>Ułóż podstawy</h3><p>C4, ADR, ramy i wzorce wyjaśnione przez decyzje, do których naprawdę się przydają.</p><span class="path-action">Poznaj podstawy <b aria-hidden="true">→</b></span></a>
      <a class="path-card" href="/narzedzia/hld/"><span class="path-index">03 / PROJEKTUJ</span><span class="path-icon" aria-hidden="true">▤</span><h3>Naszkicuj HLD</h3><p>Zamień brief w pierwszy szkic architektury z jawnymi założeniami i pytaniami do wyjaśnienia.</p><span class="path-action">Otwórz generator <b aria-hidden="true">→</b></span></a>
    </div>
  </div></section>

  <section class="this-week" id="nowe" aria-labelledby="week-title"><div class="container week-grid"><div class="week-intro"><div class="eyebrow">Najnowsza publikacja · {formatDate(editionStart)}</div><h2 id="week-title">Co dodaliśmy<br /><em>dzisiaj?</em></h2><p>{currentEditionCount} nowe materiały opublikowane <time datetime={latestEditionDate}>{new Intl.DateTimeFormat('pl-PL', {dateStyle:'long',timeZone:'UTC'}).format(editionStart)}</time>. Każdy prowadzi od konkretnej sytuacji do sprawdzalnej decyzji.</p><a class="text-link" href="/lamiglowka/">Przejdź do ćwiczenia <span aria-hidden="true">→</span></a></div><div class="week-list">
    {editions.filter(item => item.published === latestEditionDate).map(item => <a href={item.href}><span class="week-type">{item.kind} · <time datetime={item.published}>{formatDate(new Date(`${item.published}T12:00:00Z`))}</time></span><strong>{item.title}</strong><small>{item.summary}</small><span class="week-arrow" aria-hidden="true">↗</span></a>)}
  </div></div></section>
  <section class="newsletter-cta"><div class="container"><div><div class="eyebrow">Raz w tygodniu</div><h2>Najważniejsze decyzje w Twojej skrzynce</h2><p>Łamigłówka, wybrany tekst i krótki komentarz. Jeden e-mail tygodniowo.</p></div><a class="button" href="/newsletter/">Zapisz się na newsletter →</a></div></section>
  <SponsorSlot />

  <section class="about" id="omnie"><div class="container about-grid"><div class="about-mark" aria-hidden="true">WE<span>.</span></div><div><div class="eyebrow">O mnie</div><h2>Cztery dekady w IT. Nadal zaczynam od pytań.</h2><p>Nazywam się Wiesław Ejsymont. Informatyką zajmuję się od ponad 40 lat, w tym od ponad 20 lat architekturą rozwiązań i architekturą korporacyjną. Zaczynałem w czasach komputerów klasy IBM PC 286. Przez kolejne dekady rozwijałem swoje kompetencje wraz z kolejnymi przełomami technologicznymi — od pracy z serwerami z Solarisem, sieciami i programowania w asemblerze, C oraz Javie, przez rozwój internetu i coraz bardziej złożonych systemów, po obecną falę rozwoju AI. Zastosowania IT poznawałem w przemyśle, telekomunikacji i lotnictwie. Z czasem coraz bardziej zajmowało mnie to, jak wykorzystać zmieniające się technologie do budowania rozwiązań służących całej organizacji. Nowe narzędzia są ciekawe; skutki decyzji zostają na dłużej. Dlatego w ArchitectMentor pytam o cel, ryzyko i sposób sprawdzenia, czy rozwiązanie naprawdę działa.</p><a class="text-link" href="/dlafirm/">Porozmawiajmy o współpracy <span aria-hidden="true">→</span></a></div></div></section>
</Studio>

<style>
  .hero{background:#142b3b;color:#f8f7f2;position:relative;overflow:hidden}.hero:before{content:'';position:absolute;inset:0;background-image:linear-gradient(#ffffff0a 1px,transparent 1px),linear-gradient(90deg,#ffffff0a 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(90deg,transparent,#000 48%);pointer-events:none}.hero-grid{min-height:640px;padding-top:78px;padding-bottom:86px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:70px;position:relative}.hero-label{display:flex;align-items:center;gap:9px;width:max-content;padding:7px 11px;border:1px solid #436773;border-radius:30px;color:#cce1de;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.pulse,.signal{display:block;width:7px;height:7px;background:#ebaa61;border-radius:50%}.hero h1{font-size:clamp(42px,5vw,68px);line-height:1.09;max-width:12ch;margin:29px 0 23px}.hero h1 em{color:#bce4d2;font-style:normal}.hero-copy>p{color:#c9d8d8;font-size:18px;max-width:52ch;line-height:1.65}.hero-actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:30px}.button.warm{background:#d99b57;border-color:#d99b57;color:#142b3b}.button.warm:hover{background:#eab374}.hero-link{color:#eff5ed;text-underline-offset:6px;font-weight:700}.hero-trust{display:flex;gap:16px;flex-wrap:wrap;margin-top:64px;color:#a6bec2;font-size:11px;font-weight:700;letter-spacing:.03em}.hero-workspace{background:#fff;color:#182637;border-radius:15px;box-shadow:0 35px 80px #07172288;overflow:hidden;transform:rotate(1deg)}.workspace-head,.workspace-foot{display:flex;align-items:center;gap:10px;padding:15px 20px;background:#f6f8f4;font-size:10px;font-weight:800;letter-spacing:.12em;color:#5e7380}.tiny-mark{background:#136d73;border-radius:6px;color:white;padding:5px 6px;letter-spacing:-.1em}.work-label{margin-left:auto;color:#136d73}.workspace-body{padding:30px}.case-meta{display:flex;align-items:center;gap:8px;color:#136d73;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.09em}.case-count{margin-left:auto;color:#8da0a9}.workspace-body h2{font-size:clamp(20px,2.4vw,28px);max-width:22ch;margin:18px 0 24px}.work-step{display:flex;align-items:start;gap:14px;border-top:1px solid #e1e8e4;padding:16px 0}.work-step>span{display:grid;place-items:center;width:27px;height:27px;border-radius:7px;background:#e8f4ef;color:#136d73;font:800 11px var(--display)}.work-step strong,.work-step small{display:block}.work-step strong{font-size:14px}.work-step small{font-size:12px;color:#647788;margin-top:3px}.muted-step{opacity:.68}.workspace-foot{background:#e8f4ef;padding-block:13px}.avatars{display:flex;margin-right:6px}.avatars b{display:grid;place-items:center;width:23px;height:23px;background:#136d73;border:2px solid #e8f4ef;border-radius:50%;color:white;font-size:10px;margin-right:-5px}.avatars b+ b{background:#e1a35d;color:#142b3b}.workspace-foot a{margin-left:auto;font-size:20px;text-decoration:none;color:#136d73}
  .hero-latest{display:flex;align-items:center;gap:11px;flex-wrap:wrap;width:fit-content;max-width:100%;padding:10px 14px;margin-top:22px;background:#204354;border:1px solid #4d7280;border-radius:8px;text-decoration:none;font-size:12px}.hero-latest span{font-size:10px;color:#bce4d2;letter-spacing:.08em;font-weight:800}.hero-latest b{font-size:17px;color:#e1a35d}.hero-latest:hover{text-decoration:underline}.this-week{scroll-margin-top:150px}
  .pathways{padding:95px 0}.section-top{display:flex;align-items:end;justify-content:space-between;gap:50px;margin-bottom:34px}.section-top h2,.week-intro h2,.about h2{font-size:clamp(31px,4vw,47px);margin:14px 0 0}.section-top>p{max-width:380px;color:#536577;margin:0 0 7px}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.path-card{position:relative;display:flex;flex-direction:column;min-height:300px;padding:29px;border-radius:12px;border:1px solid #dce4df;background:white;text-decoration:none;transition:transform .2s,box-shadow .2s}.path-card:hover{transform:translateY(-4px);box-shadow:0 14px 35px #142b3b14}.path-card.featured{background:#e8f4ef;border-color:#b6d4c9}.path-index{font-size:11px;font-weight:800;letter-spacing:.14em;color:#136d73}.path-icon{position:absolute;right:26px;top:20px;font-size:31px;color:#97aaa9}.path-card h3{font-size:25px;margin:58px 0 10px}.path-card p{font-size:14px;color:#536577;max-width:31ch}.path-action{font-size:13px;font-weight:800;color:#136d73;margin-top:auto;padding-top:23px}.path-action b{float:right;font-size:20px;font-weight:400}
  .this-week{background:#fff;padding:94px 0}.week-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px}.week-intro h2 em{font-style:normal;color:#136d73}.week-intro p{max-width:36ch;color:#536577;margin:20px 0 28px}.text-link{color:#136d73;font-weight:800;text-underline-offset:5px;text-decoration-thickness:2px}.text-link span{margin-left:6px}.week-list{border-top:1px solid #dce4df}.week-list a{position:relative;display:block;text-decoration:none;border-bottom:1px solid #dce4df;padding:23px 45px 23px 0}.week-list a:hover strong{color:#136d73}.week-type,.week-list strong,.week-list small{display:block}.week-type{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}.week-list strong{font:700 19px/1.35 var(--display);letter-spacing:-.025em;margin:7px 0}.week-list small{color:#667989}.week-arrow{position:absolute;right:3px;top:42px;color:#136d73;font-size:24px}.about{padding:86px 0;background:#e8f4ef}.about-grid{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:80px;max-width:900px}.about-mark{display:grid;place-items:center;height:190px;width:190px;border-radius:50%;background:#136d73;color:#fff;font:800 64px var(--display);letter-spacing:-.1em}.about-mark span{color:#e1a35d}.about h2{max-width:16ch}.about p{color:#40566a;max-width:61ch;margin:19px 0 24px}
  .newsletter-cta{background:#e8f4ef;padding:50px 0}.newsletter-cta>.container{display:flex;align-items:center;justify-content:space-between;gap:32px}.newsletter-cta h2{font-size:clamp(25px,3vw,36px);margin:9px 0}.newsletter-cta p{color:#40566a;margin:0}.newsletter-cta .button{flex:none}
  @media(max-width:920px){.hero-grid{gap:35px;grid-template-columns:1fr 1fr}.hero-trust{margin-top:40px}.week-grid{gap:35px}.path-card{padding:22px}}
  @media(max-width:720px){.hero-grid{grid-template-columns:1fr;padding-top:52px;padding-bottom:65px;min-height:0}.hero h1{max-width:15ch}.hero-workspace{transform:none;max-width:520px}.hero-trust{gap:9px}.pathways,.this-week{padding:64px 0}.section-top{display:block}.section-top>p{margin-top:16px}.path-grid,.week-grid{grid-template-columns:1fr}.path-card{min-height:235px}.path-card h3{margin-top:34px}.week-list{margin-top:14px}.newsletter-cta>.container{display:block}.newsletter-cta .button{margin-top:24px}.about-grid{grid-template-columns:1fr;gap:24px}.about-mark{width:90px;height:90px;font-size:34px}.about{padding:64px 0}}
  @media(prefers-reduced-motion:reduce){.path-card{transition:none}}
</style>
