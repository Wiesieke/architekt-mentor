---
import Studio from '../layouts/Studio.astro';
import StarterExercises from './StarterExercises.astro';
import { homepageData } from '../data/homepage';
import translations from '../data/homepage-copy.json';
interface Props { locale: 'pl' | 'en' }
const { locale } = Astro.props;
const copy = translations[locale];
const data = homepageData(locale);
const materialForm = new Intl.PluralRules(locale).select(data.edition.length);
const materialLabel = copy.materialForms[materialForm as keyof typeof copy.materialForms] ?? copy.materialForms.other;
---
<Studio locale={locale} title={copy.title} description={copy.description} translationUrl={data.translationUrl} modified={data.date}>
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{copy.eyebrow}</div><h1>{copy.headline} <em>{copy.emphasis}</em></h1><p>{copy.intro}</p><div class="actions"><a class="button" href={data.practiceUrl}>{copy.cta}</a><a href="#start">{copy.how}</a></div></div><div class="focus"><small>{copy.latest} · {data.featured.kind}</small><h2><a href={data.featured.href}>{data.featured.title}</a></h2><p>{data.featured.description}</p><a href={data.featured.href}>{copy.read}</a></div></div></section>
  <section class="container paths" id="start"><div class="eyebrow">{copy.start}</div><h2>{copy.startTitle}</h2><p class="path-intro">{copy.startIntro}</p><div class="cards">{copy.paths.map((path,i)=><a class:list={{'featured-path':i===0}} href={data.pathUrls[i]}><small>{path.label}</small><h3>{path.title}</h3><p>{path.description}</p><span>{path.action}</span></a>)}</div></section>
  <section class="weekly" id="latest"><div class="container"><div class="eyebrow">{copy.publication} · <time datetime={data.date}>{data.dateLabel}</time></div><h2>{copy.newTitle}</h2><p>{data.edition.length} {materialLabel}. {copy.newIntro}</p><div class="weekly-grid">{data.edition.map(item=><a href={item.href} data-edition-kind={item.kind}><small>{copy.kinds[item.kind as keyof typeof copy.kinds]}</small><strong>{item.title}</strong><span>{item.summary}</span></a>)}</div></div></section>
  <StarterExercises locale={locale} />
  <section class="newsletter-cta"><div class="container"><div><div class="eyebrow">{copy.newsletterLabel}</div><h2>{copy.newsletterTitle}</h2><p>{copy.newsletterText}</p></div><a class="button" href={data.newsletterUrl}>{copy.subscribe}</a></div></section>
  <section class="highlight" id="omnie"><div class="container highlight-grid"><div><div class="eyebrow">{copy.pattern}</div><h2>{data.foundation.title}</h2><p>{data.foundation.description}</p><a href={data.foundation.href}>{copy.read}</a></div><div><div class="eyebrow">{copy.about}</div><h2>{copy.aboutTitle}</h2><p>{copy.bio}</p><a href={data.businessUrl}>{copy.contact}</a></div></div></section>
  <section class="container secondary-section"><div class="eyebrow">{copy.tutorialLabel}</div><h2>{copy.tutorialTitle}</h2><p>{copy.tutorialText}</p><a class="button" href={data.tutorialUrl}>{copy.tutorialCta}</a></section>
  <section class="container secondary-section"><div class="eyebrow">{copy.eventsLabel}</div><h2>{copy.eventsTitle}</h2><p>{copy.eventsText}</p><a class="button" href={data.eventsUrl}>{copy.eventsCta}</a></section>
</Studio>
<style>
  .hero{background:#142b3b;color:#f8f7f2}.hero-grid{min-height:570px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:70px;padding-top:70px;padding-bottom:80px}.hero h1{font-size:clamp(42px,5vw,68px);line-height:1.09;max-width:13ch;margin:28px 0 22px}.hero h1 em{color:#bce4d2;font-style:normal}.hero p{font-size:18px;max-width:56ch;color:#c9d8d8}.hero .eyebrow{color:#bce4d2}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:28px}.actions>a:not(.button){color:#f8f7f2;font-weight:700}.focus{background:#fff;color:#182637;padding:34px;border-radius:14px}.focus small,.cards small{color:#136d73;font-size:11px;font-weight:800;letter-spacing:.12em}.focus h2{font-size:29px}.focus h2 a{text-decoration:none}.focus p{font-size:15px;color:#536577}.focus>a,.highlight a{color:#136d73;font-weight:800}.paths{padding-top:85px;padding-bottom:90px;scroll-margin-top:110px}.paths h2,.weekly h2{font-size:clamp(30px,4vw,44px);max-width:18ch}.path-intro{max-width:68ch;color:#536577;margin:0 0 30px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:32px}.cards a{display:block;background:#fff;border:1px solid #dce4df;border-radius:12px;padding:30px;text-decoration:none}.cards a.featured-path{background:#e8f4ef;border-color:#b6d4c9}.cards h3{font-size:25px}.cards p{color:#536577}.cards span{color:#136d73;font-weight:800}.weekly{background:#fff;padding:80px 0}.weekly>div>p{color:#536577;max-width:65ch}.weekly-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:30px}.weekly-grid a{display:flex;flex-direction:column;padding:23px;border:1px solid #dce4df;border-radius:10px;text-decoration:none}.weekly-grid small{color:#136d73;font-size:11px;font-weight:800}.weekly-grid strong{font:700 20px var(--display);margin:9px 0}.weekly-grid span{color:#536577;font-size:13px;margin-top:auto}.newsletter-cta{background:#e8f4ef;padding:50px 0}.newsletter-cta>.container{display:flex;justify-content:space-between;align-items:center;gap:32px}.newsletter-cta h2{font-size:clamp(25px,3vw,36px);margin:9px 0}.newsletter-cta p{margin:0;color:#40566a}.newsletter-cta .button{flex:none}.highlight{background:#e8f4ef;padding:80px 0}.highlight-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.highlight h2{font-size:clamp(26px,3vw,38px)}.highlight p{color:#40566a}@media(max-width:720px){.hero-grid,.cards,.weekly-grid,.highlight-grid{grid-template-columns:1fr;gap:25px}.hero-grid{padding-top:52px;padding-bottom:60px}.paths,.weekly,.highlight{padding-top:60px;padding-bottom:60px}.newsletter-cta>.container{display:block}.newsletter-cta .button{margin-top:24px}.focus,.cards a{padding:22px}}

.secondary-section{padding-block:35px}
</style>
