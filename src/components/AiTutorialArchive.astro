---
import Studio from '../layouts/Studio.astro';
import { articles, articleUrl } from '../data/articles';
import { englishArticles, englishArticleUrl } from '../data/articles-en';
const {locale = 'pl'} = Astro.props;
const en = locale === 'en';
const items = en ? englishArticles.filter(a=>a.section==='architecture-with-ai').map(a=>({...a,url:englishArticleUrl(a)})) : articles.filter(a=>a.section==='architektura-it-ai').map(a=>({...a,url:articleUrl(a)}));
const title = en ? 'IT architecture in the age of AI' : 'Architektura IT w dobie AI';
const subtitle = en ? 'How an architect works with AI' : 'Jak architekt pracuje z AI';
---
<Studio locale={locale} title={title} description={subtitle} translationUrl={en ? '/architektura-it-ai/' : '/en/architecture-with-ai/'}>
<section class="container ai-archive"><div class="eyebrow">{en ? 'Practical tutorials' : 'Praktyczne tutoriale'}</div><h1>{title}</h1><h2>{subtitle}</h2><p class="intro">{en ? 'Use AI to clarify a brief, compare options and challenge a design. Learn to check its assumptions, diagrams and recommendations before making a decision.' : 'Wykorzystuj AI do doprecyzowania briefu, porównywania wariantów i przeglądu projektu. Naucz się sprawdzać założenia, diagramy i rekomendacje przed podjęciem decyzji.'}</p><p class="rhythm">{en ? 'One new tutorial each week. Start with a small task, follow the review and try it yourself.' : 'Jeden nowy tutorial tygodniowo. Zacznij od małego zadania, prześledź przegląd i wykonaj własną próbę.'}</p><div class="tutorials">{items.map(a=><article><span>{a.topic} · <time datetime={a.published}>{a.published}</time></span><h3><a href={a.url}>{a.title}</a></h3><p>{a.description}</p><a href={a.url}>{en ? 'Work through the tutorial →' : 'Przejdź tutorial →'}</a></article>)}</div><aside><h2>{en ? 'The learning path' : 'Ścieżka nauki'}</h2><p>{en ? 'Next topics: questions before design, comparing alternatives, reviewing dependencies, and turning a decision into an ADR. These are planned topics; new links will appear as tutorials are published.' : 'Kolejne tematy: pytania przed projektowaniem, porównywanie wariantów, przegląd zależności i przejście od decyzji do ADR. To planowane tematy; linki pojawią się po publikacji tutoriali.'}</p><a href={en ? '/en/tools/hld/' : '/narzedzia/hld/'}>{en ? 'Open the HLD generator →' : 'Otwórz generator HLD →'}</a></aside></section>
</Studio>
<style>.ai-archive{padding-block:55px 85px;max-width:1000px}.ai-archive h1{font-size:clamp(35px,5vw,56px);margin:20px 0}.ai-archive h2{font-size:25px}.intro{font-size:19px;max-width:70ch;color:var(--muted)}.rhythm{padding:15px 20px;background:var(--mint);border-radius:10px}.tutorials{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:30px}.tutorials article{padding:28px;background:#fff;border:1px solid var(--line);border-radius:12px}.tutorials span{font-size:12px;color:var(--teal)}.tutorials h3{font-size:26px}.tutorials h3 a{text-decoration:none}.tutorials article>a,aside a{color:var(--teal);font-weight:700}aside{margin-top:38px;max-width:75ch}@media(max-width:660px){.tutorials{grid-template-columns:1fr}.ai-archive{padding-top:30px}}</style>
