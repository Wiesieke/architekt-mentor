---
import Studio from '../layouts/Studio.astro';
import PuzzleExercise from '../components/PuzzleExercise.astro';
import puzzles from '../../data/puzzles.json';
import { marked } from 'marked';

const { puzzle } = Astro.props as { puzzle: (typeof puzzles)[number] };
const paragraphs = puzzle.scenario.split(/\n\n+/);
const analysis = marked.parse(puzzle.analysis);
interface DecisionRecord { status:string; context:string; decision:string; rationale:string; consequences:string[]; verification:string; openQuestions:string[] }
const decisionRecord = (puzzle as typeof puzzle & {decisionRecord?:DecisionRecord}).decisionRecord;
interface Related {type:string;title:string;description:string;href:string}
const related = (puzzle as typeof puzzle & {related?:Related[]}).related ?? [
  {type:'ANTYWZORCE',title:'Rozpoznaj typowe pułapki',description:'Zobacz inne sytuacje →',href:'/antywzorce/'},
  {type:'PODSTAWY',title:'Poznaj wzorce architektoniczne',description:'Wróć do podstaw →',href:'/podstawy-architektury/'},
];
const recordMarkdown = decisionRecord ? [
  `# ADR: ${puzzle.title}`, '', `Status: ${decisionRecord.status}`, '',
  '## Kontekst', decisionRecord.context, '',
  '## Decyzja', decisionRecord.decision, '',
  '## Uzasadnienie', decisionRecord.rationale, '',
  '## Konsekwencje', ...decisionRecord.consequences.map(line => `- ${line}`), '',
  '## Jak sprawdzimy decyzję?', decisionRecord.verification, '',
  '## Pytania otwarte', ...decisionRecord.openQuestions.map(line => `- ${line}`), '',
  'Przykład fikcyjny do nauki; przed zastosowaniem w projekcie wymagane są jego własne dane i decyzja.'
].join('\n') : '';
---
<Studio title={puzzle.title} description={puzzle.coach ? "Praktyczna łamigłówka architektoniczna z pytaniem mentora i analizą seniora." : "Archiwalna łamigłówka architektoniczna z analizą seniora."} published={puzzle.date} active="practice">
  <div class="exercise-head"><div class="container"><a class="back" href="/lamiglowki/">← Wszystkie łamigłówki</a><div class="head-grid"><div><div class="eyebrow">Warsztat decyzji · {puzzle.week}</div><h1>{puzzle.title}</h1><p>Rozpoznaj ryzyko, podejmij decyzję i porównaj swój tok myślenia z analizą seniora. W wybranych ćwiczeniach zadasz też pytanie mentorowi AI.</p></div><div class="head-aside"><span>CEL ĆWICZENIA</span><strong>Uzasadnij granicę awarii.</strong><small>Szacowany czas: 8–12 minut</small></div></div></div></div>
  <div class="container exercise-grid" data-puzzle-id={puzzle.id}>
    <aside class="sidebar" aria-label="Etapy ćwiczenia"><div class="sidebar-sticky"><div class="sidebar-label">TWOJA ŚCIEŻKA</div><ol><li class="active" id="step-read"><b>1</b><span>Rozpoznaj sytuację<small>Fakty i niewiadome</small></span></li><li id="step-answer"><b>2</b><span>Opisz decyzję<small>Twoje rozumowanie</small></span></li><li id="step-mentor"><b>3</b><span>Sprawdź z mentorem<small>Pytanie i ocena</small></span></li><li id="step-analysis"><b>4</b><span>Porównaj z analizą<small>Kompromisy i test</small></span></li><li id="step-record"><b>5</b><span>Zabierz ADR<small>Wzór zapisu decyzji</small></span></li></ol><div class="sidebar-rule">Dobra odpowiedź pokazuje nie tylko <em>co</em> zrobić, ale <em>dlaczego</em> i jak to sprawdzić.</div></div></aside>
    <div class="content">
      <article class="case-block"><div class="block-top"><span class="block-number">01</span><span>SCENARIUSZ</span><span class="difficulty">{puzzle.difficulty}</span></div><div class="case-body"><h2>Co wiemy?</h2>{paragraphs.map(p => <p>{p}</p>)}<div class="question"><span>Pytanie do Ciebie</span><p>{puzzle.question}</p></div><details class="hints"><summary>Za co mentor ocenia odpowiedź? <span aria-hidden="true">＋</span></summary><p>Wynik jest wskazówką do nauki, nie oceną zawodowych kompetencji.</p><ul>{(puzzle.coach?.criteria ?? []).map(c => <li>{c.label}</li>)}</ul></details><details class="hints"><summary>Zobacz pytania naprowadzające <span aria-hidden="true">＋</span></summary><ul>{puzzle.hints.map(h => <li>{h}</li>)}</ul></details></div></article>
      <section class="answer-block" aria-labelledby="answer-title"><div class="block-top"><span class="block-number">02</span><span>TWOJA DECYZJA</span></div><div class="answer-body"><h2 id="answer-title">Jak Ty byś to rozwiązał?</h2><p>Wpisz decyzję, najważniejszy argument i sposób jej sprawdzenia. Możesz najpierw napisać wersję roboczą.</p><label class="answer-label" for="answer">Twoja pierwsza odpowiedź</label><textarea id="answer" maxlength="4000" placeholder="Zacząłbym od... ponieważ... Sprawdziłbym to przez..." aria-describedby="answer-help"></textarea><div class="answer-help" id="answer-help"><span id="counter">0 / 4000 znaków</span><span>Minimum 40 znaków do oceny</span></div><div class="privacy" hidden={!puzzle.coach}><label><input type="checkbox" id="save-answer" /> Zapisz odpowiedź i ocenę na 90 dni, aby rozwijać narzędzie</label><a href="/informacja-o-danych/">Jak przetwarzamy dane?</a></div><p class="small-note">{puzzle.coach ? "Odpowiedź zostanie wysłana do mentora AI w celu przygotowania informacji zwrotnej. Nie wpisuj danych poufnych." : "To archiwalne ćwiczenie zawiera analizę seniora; ocena AI nie jest dla niego dostępna."}</p><div class="answer-actions"><button class="button" id="coach-button" type="button" hidden={!puzzle.coach}>{puzzle.coach ? "Poproś mentora o pytanie" : "Mentor AI niedostępny"} <span aria-hidden="true">→</span></button><span id="coach-status" role="status" aria-live="polite"></span></div><div id="coach-result" aria-live="polite"></div><section class="revision" id="revision" aria-labelledby="revision-title" hidden><div class="revision-step">ODPOWIEDŹ PO PYTANIU MENTORA</div><h3 id="revision-title">Teraz doprecyzuj swoją decyzję</h3><p>Odpowiedz na pytanie mentora i zapisz pełną, poprawioną odpowiedź. Pierwsza wersja pozostaje powyżej do porównania.</p><button class="copy-answer" id="copy-answer" type="button">Wstaw moją pierwszą odpowiedź</button><label class="answer-label" for="revised-answer">Twoja poprawiona odpowiedź</label><textarea id="revised-answer" maxlength="4000" placeholder="Po pytaniu mentora uzupełniam decyzję o... ponieważ... Sprawdzę to przez..." aria-describedby="revised-help"></textarea><div class="answer-help" id="revised-help"><span id="revised-counter">0 / 4000 znaków</span><span>Minimum 40 znaków do oceny</span></div><div class="answer-actions"><button class="button" id="score-button" type="button">Oceń poprawioną odpowiedź <span aria-hidden="true">→</span></button><span id="score-status" role="status" aria-live="polite"></span></div><div id="score-result" aria-live="polite"></div><button class="button secondary after-score" id="review-after-score" type="button" hidden>Porównaj z analizą seniora ↓</button></section></div></section>
      <section class="analysis-block" aria-labelledby="analysis-title" id="senior"><div class="block-top"><span class="block-number">03</span><span>ANALIZA SENIORA</span></div><div class="analysis-intro"><div><h2 id="analysis-title" tabindex="-1">Porównaj tok rozumowania</h2><p>Pełna analiza jest dostępna również bez oceny AI.</p></div><button class="button secondary" id="reveal" type="button" aria-expanded="false" aria-controls="analysis">Pokaż analizę <span aria-hidden="true">↓</span></button></div><div class="analysis-content" id="analysis" hidden set:html={analysis} /></section>
      {decisionRecord && <section class="record-block" id="adr" aria-labelledby="record-title"><div class="block-top"><span class="block-number">04</span><span>ZABIERZ ZAPIS DECYZJI</span></div><div class="record-body"><div class="eyebrow">Przykładowy ADR · fikcyjna sytuacja</div><h2 id="record-title">Jak zapisać decyzję po ćwiczeniu?</h2><p>To jedna możliwa decyzja, a nie gotowa recepta ani zatwierdzenie projektu. Porównaj ją ze swoją odpowiedzią i uzupełnij pytania otwarte.</p><dl><dt>Status</dt><dd>{decisionRecord.status}</dd><dt>Kontekst</dt><dd>{decisionRecord.context}</dd><dt>Decyzja</dt><dd>{decisionRecord.decision}</dd><dt>Uzasadnienie</dt><dd>{decisionRecord.rationale}</dd><dt>Konsekwencje</dt><dd><ul>{decisionRecord.consequences.map(item => <li>{item}</li>)}</ul></dd><dt>Jak sprawdzimy decyzję?</dt><dd>{decisionRecord.verification}</dd><dt>Pytania otwarte</dt><dd><ul>{decisionRecord.openQuestions.map(item => <li>{item}</li>)}</ul></dd></dl><a class="button secondary" href={`data:text/markdown;charset=utf-8,${encodeURIComponent(recordMarkdown)}`} download={`ADR-${puzzle.id}.md`}>Pobierz przykładowy ADR (.md) ↓</a></div></section>}
      <section class="further" aria-labelledby="further-title"><span>POWIĄZANA WIEDZA</span><h2 id="further-title">Co warto przeczytać po ćwiczeniu?</h2><div class="related-grid">{related.map(item => <a href={item.href}><small>{item.type}</small><strong>{item.title}</strong><span>{item.description} →</span></a>)}</div></section>
    </div>
  </div>
</Studio>

<script>
  const root = document.querySelector<HTMLElement>('[data-puzzle-id]');
  const answer = document.querySelector<HTMLTextAreaElement>('#answer');
  const hintButton = document.querySelector<HTMLButtonElement>('#coach-button');
  const hintResult = document.querySelector<HTMLElement>('#coach-result');
  const hintStatus = document.querySelector<HTMLElement>('#coach-status');
  const revision = document.querySelector<HTMLElement>('#revision');
  const revisedAnswer = document.querySelector<HTMLTextAreaElement>('#revised-answer');
  const scoreButton = document.querySelector<HTMLButtonElement>('#score-button');
  const scoreResult = document.querySelector<HTMLElement>('#score-result');
  const scoreStatus = document.querySelector<HTMLElement>('#score-status');
  const counter = document.querySelector<HTMLElement>('#counter');
  const revisedCounter = document.querySelector<HTMLElement>('#revised-counter');
  const copyAnswer = document.querySelector<HTMLButtonElement>('#copy-answer');
  const reveal = document.querySelector<HTMLButtonElement>('#reveal');
  const analysis = document.querySelector<HTMLElement>('#analysis');
  const reviewAfterScore = document.querySelector<HTMLButtonElement>('#review-after-score');
  const save = document.querySelector<HTMLInputElement>('#save-answer');
  let attemptId: string | null = null;
  const markStep = (id: string) => document.querySelector('#'+id)?.classList.add('active');
  answer?.addEventListener('focus', () => markStep('step-answer'));
  answer?.addEventListener('input', () => { if(counter && answer) counter.textContent = `${answer.value.length} / 4000 znaków`; });
  revisedAnswer?.addEventListener('input', () => { if(revisedCounter && revisedAnswer) revisedCounter.textContent = `${revisedAnswer.value.length} / 4000 znaków`; });
  copyAnswer?.addEventListener('click', () => {
    if(!answer || !revisedAnswer || !revisedCounter) return;
    revisedAnswer.value = answer.value;
    revisedCounter.textContent = `${revisedAnswer.value.length} / 4000 znaków`;
    revisedAnswer.focus();
  });
  reveal?.addEventListener('click', () => {
    if(!reveal || !analysis) return;
    const open = reveal.getAttribute('aria-expanded') !== 'true';
    reveal.setAttribute('aria-expanded', String(open));
    analysis.hidden = !open;
    reveal.textContent = open ? 'Ukryj analizę ↑' : 'Pokaż analizę ↓';
    if(open) markStep('step-analysis');
  });
  reviewAfterScore?.addEventListener('click', () => {
    if(reveal?.getAttribute('aria-expanded') !== 'true') reveal?.click();
    document.querySelector('#senior')?.scrollIntoView({behavior:'smooth',block:'start'});
    document.querySelector<HTMLElement>('#analysis-title')?.focus({preventScroll:true});
  });
  document.querySelector('#adr a[download]')?.addEventListener('click', () => markStep('step-record'));
  function para(text: string, cls?: string){ const p=document.createElement('p');p.textContent=text;if(cls)p.className=cls;return p; }
  async function askMentor(stage: 'hint' | 'score', value: string) {
    if(!root) throw new Error('Nie udało się odczytać łamigłówki.');
    const response=await fetch('/api/evaluate-puzzle',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({puzzleId:root.dataset.puzzleId,stage,answer:value,attemptId,saveAnswer:save?.checked===true})});
    const data=await response.json();
    if(!response.ok)throw new Error(data.error||'Ocena chwilowo niedostępna.');
    attemptId=data.attemptId||attemptId;
    return data;
  }
  function storageNote(data: {saved?: boolean; recordId?: string}) {
    if(data.saved===true) return ` Zapisano (ID: ${data.recordId}).`;
    if(data.saved===false) return ' Zapis nie powiódł się; zachowaj odpowiedź u siebie.';
    return '';
  }
  hintButton?.addEventListener('click', async () => {
    if(!hintButton || !answer || !hintStatus || !hintResult || !revision || !revisedAnswer) return;
    const value=answer.value.trim();
    if(value.length<40){hintStatus.textContent='Opisz decyzję trochę szerzej — minimum 40 znaków.';answer.focus();return;}
    hintButton.disabled=true;hintButton.textContent='Mentor przygotowuje pytanie…';hintStatus.textContent='';
    try{
      const data=await askMentor('hint',value);
      hintResult.replaceChildren();markStep('step-mentor');
      const card=document.createElement('div');card.className='feedback';
      card.append(para('PYTANIE MENTORA','feedback-label'),para(data.positive||''),para(data.question||'','feedback-question'));
      hintResult.append(card);
      hintStatus.textContent='Poniżej otworzyło się osobne pole na poprawioną odpowiedź.'+storageNote(data);
      answer.readOnly=true;
      hintButton.hidden=true;
      revision.hidden=false;
      revisedAnswer.focus();
    }catch(error){hintStatus.textContent=error instanceof Error?error.message:'Pytanie mentora jest chwilowo niedostępne.';hintButton.textContent='Poproś mentora o pytanie →';}
    finally{hintButton.disabled=false;}
  });
  scoreButton?.addEventListener('click', async () => {
    if(!scoreButton || !revisedAnswer || !scoreStatus || !scoreResult) return;
    const value=revisedAnswer.value.trim();
    if(value.length<40){scoreStatus.textContent='Wpisz pełną poprawioną odpowiedź — minimum 40 znaków.';revisedAnswer.focus();return;}
    scoreButton.disabled=true;scoreButton.textContent='Mentor ocenia odpowiedź…';scoreStatus.textContent='';
    try{
      const data=await askMentor('score',value);
      scoreResult.replaceChildren();
      const card=document.createElement('div');card.className='feedback';
      card.append(para('OCENA POMOCNICZA','feedback-label'),para(`${data.score ?? '?'} / ${data.maxScore ?? '?'} punktów`,'feedback-score'),para(data.overall||''));
      if(Array.isArray(data.criteria)){const list=document.createElement('ul');for(const c of data.criteria){const li=document.createElement('li');li.textContent=`${c.label}: ${c.points}/2 — ${c.reason}`;list.append(li)}card.append(list)}
      card.append(para(data.nextStep||''));scoreResult.append(card);
      scoreStatus.textContent='Ocena gotowa. Sprawdź analizę seniora i przykładowy ADR.'+storageNote(data);
      revisedAnswer.readOnly=true;
      scoreButton.hidden=true;
      if(copyAnswer)copyAnswer.hidden=true;
      if(reviewAfterScore)reviewAfterScore.hidden=false;
    }catch(error){scoreStatus.textContent=error instanceof Error?error.message:'Ocena chwilowo niedostępna.';scoreButton.textContent='Oceń poprawioną odpowiedź →';}
    finally{scoreButton.disabled=false;}
  });
</script>

<style>
  .exercise-head{background:#142b3b;color:#f8f7f2;padding:35px 0 62px}.back{font-size:12px;font-weight:700;text-decoration:none;color:#bed6d7}.back:hover{text-decoration:underline}.head-grid{display:grid;grid-template-columns:1fr 235px;align-items:end;gap:80px;margin-top:53px}.exercise-head .eyebrow{color:#bce4d2}.exercise-head h1{font-size:clamp(33px,4.4vw,55px);max-width:17ch;margin:18px 0}.exercise-head p{max-width:67ch;color:#c5d8d8;margin:0}.head-aside{border-left:2px solid #5e8890;padding-left:21px}.head-aside span,.head-aside strong,.head-aside small{display:block}.head-aside span{font-size:10px;letter-spacing:.15em;color:#bce4d2;font-weight:800}.head-aside strong{font:700 21px/1.3 var(--display);margin:9px 0}.head-aside small{color:#acc6c8}.exercise-grid{display:grid;grid-template-columns:220px minmax(0,760px);gap:55px;padding-top:56px;padding-bottom:88px}.sidebar-sticky{position:sticky;top:126px}.sidebar-label{font-size:11px;letter-spacing:.14em;font-weight:800;color:#748995}.sidebar ol{padding:0;margin:22px 0 0;list-style:none}.sidebar li{display:flex;gap:12px;align-items:start;padding:0 0 26px;position:relative;color:#82929b}.sidebar li:not(:last-child):after{content:'';position:absolute;left:13px;top:30px;bottom:2px;border-left:1px solid #cdd9d6}.sidebar li.active{color:#136d73}.sidebar b{flex:none;display:grid;place-items:center;border-radius:50%;border:1px solid #c9d7d2;width:28px;height:28px;background:#f8f7f2;font-size:11px}.sidebar li.active b{background:#136d73;border-color:#136d73;color:#fff}.sidebar li span{font-weight:700;font-size:13px}.sidebar li small{display:block;font-weight:400;color:#7c8d98;font-size:11px;margin-top:1px}.sidebar-rule{background:#e8f4ef;border-radius:10px;color:#405c61;font-size:12px;line-height:1.6;padding:18px;margin-top:10px}.content{min-width:0}.case-block,.answer-block,.analysis-block{border:1px solid #dce4df;border-radius:14px;background:#fff;overflow:hidden;margin-bottom:21px}.block-top{display:flex;align-items:center;gap:11px;border-bottom:1px solid #e8ede8;padding:15px 28px;color:#617880;font-size:11px;font-weight:800;letter-spacing:.13em}.block-number{display:grid;place-items:center;width:25px;height:25px;background:#e8f4ef;border-radius:6px;color:#136d73;letter-spacing:0}.difficulty{margin-left:auto;border-radius:18px;padding:4px 10px;background:#f4f5ee;letter-spacing:0;color:#46636e}.case-body,.answer-body{padding:27px 32px 33px}.case-body h2,.answer-body h2,.analysis-intro h2{font-size:25px;margin:0 0 16px}.case-body>p{color:#3d5261;line-height:1.78;margin:0 0 18px}.question{border-left:3px solid #e1a35d;background:#fbf7eb;padding:15px 20px;margin:27px 0}.question span{font-size:10px;font-weight:800;letter-spacing:.13em;color:#85602f}.question p{font-weight:700;margin:6px 0 0;line-height:1.55}.hints{border-top:1px solid #e8ede8;padding-top:15px}.hints summary{cursor:pointer;color:#136d73;font-size:13px;font-weight:800;list-style:none}.hints summary::-webkit-details-marker{display:none}.hints summary span{float:right;font-size:19px;font-weight:400}.hints ul{color:#536577;font-size:13px;padding-left:19px;line-height:1.6}.hints li{margin:9px 0}.answer-body>p{color:#536577;font-size:14px}.answer-label{display:block;margin-top:24px;margin-bottom:8px;font-size:13px;font-weight:800}.answer-body textarea{width:100%;height:195px;resize:vertical;padding:16px;border:1px solid #c9d8d4;border-radius:9px;background:#fefefd;color:#182637;line-height:1.6}.answer-help{display:flex;justify-content:space-between;gap:10px;color:#778994;font-size:11px}.privacy{margin-top:24px;padding:15px;background:#f5f8f5;border-radius:8px;font-size:12px}.privacy label{display:flex;gap:8px;align-items:start}.privacy input{margin:3px 0 0}.privacy a{display:inline-block;color:#136d73;margin:5px 0 0 21px}.answer-body p.small-note{margin:14px 0 0;font-size:11px}.answer-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:22px}.answer-actions .button:disabled{opacity:.65;cursor:wait}#coach-status{font-size:12px;color:#536577}.feedback{background:#e8f4ef;border:1px solid #bddbd2;border-radius:10px;margin-top:24px;padding:22px}.feedback p{font-size:14px}.feedback .feedback-label{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}.feedback .feedback-question{font-weight:800;font-size:16px}.feedback .feedback-score{font:800 24px var(--display);color:#136d73}.feedback li{font-size:13px;margin:10px 0}.analysis-intro{padding:26px 32px;display:flex;justify-content:space-between;align-items:center;gap:20px}.analysis-intro h2{margin-bottom:5px}.analysis-intro p{color:#536577;font-size:13px;margin:0}.analysis-intro .button{font-size:12px;white-space:nowrap}.analysis-content{padding:0 32px 30px;border-top:1px solid #e8ede8;color:#3e5360}.analysis-content :global(h3){font-size:19px;margin:28px 0 7px}.analysis-content :global(p),.analysis-content :global(li){font-size:14px;line-height:1.7}.analysis-content :global(ul),.analysis-content :global(ol){padding-left:21px}.analysis-content :global(blockquote){border-left:3px solid #e1a35d;padding:8px 15px;background:#fbf7eb;margin-left:0}.further{padding:17px 4px;color:#536577}.further span{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}.further p{margin:7px 0}.further a{color:#136d73;font-weight:700}
  #coach-result :global(.feedback){background:#e8f4ef;border:1px solid #bddbd2;border-radius:10px;margin-top:24px;padding:22px}#coach-result :global(.feedback p){font-size:14px}#coach-result :global(.feedback .feedback-label){font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}#coach-result :global(.feedback .feedback-question){font-weight:800;font-size:16px}#coach-result :global(.feedback .feedback-score){font:800 24px var(--display);color:#136d73}#coach-result :global(.feedback li){font-size:13px;margin:10px 0}
  [hidden]{display:none!important}
  .revision{border-top:1px solid #dce4df;margin-top:28px;padding-top:25px}
  .revision-step{font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}
  .revision h3{font:700 22px/1.3 var(--display);margin:11px 0 8px}
  .revision p{font-size:14px;color:#536577;line-height:1.6;margin:0}
  .copy-answer{border:0;background:transparent;padding:0;color:#136d73;font:700 12px var(--sans);text-decoration:underline;cursor:pointer;margin-top:15px}
  #coach-status,#score-status{font-size:12px;color:#536577}
  #score-result :global(.feedback){background:#e8f4ef;border:1px solid #bddbd2;border-radius:10px;margin-top:24px;padding:22px}
  #score-result :global(.feedback p){font-size:14px}
  #score-result :global(.feedback .feedback-label){font-size:10px;letter-spacing:.13em;font-weight:800;color:#136d73}
  #score-result :global(.feedback .feedback-score){font:800 24px var(--display);color:#136d73}
  #score-result :global(.feedback li){font-size:13px;margin:10px 0}
  .hints p{font-size:12px;color:#536577;margin:12px 0 0}
  .after-score{margin-top:20px}
  #senior{scroll-margin-top:110px}
  .record-block{border:1px solid #dce4df;border-radius:14px;background:#fff;overflow:hidden;margin-bottom:21px}
  .record-body{padding:29px 32px 35px}
  .record-body h2{font-size:25px;margin:16px 0 9px}
  .record-body>p{font-size:14px;line-height:1.65;color:#536577}
