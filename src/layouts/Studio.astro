---
interface Props { title: string; description: string; active?: 'home' | 'practice' }
const { title, description, active = 'home' } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} | Architekt-Mentor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Architekt-Mentor — strona główna"><span class="brand-icon" aria-hidden="true">AM<span class="brand-dot">.</span></span><span class="brand-name">Architekt<span>Mentor</span></span></a>
        <nav aria-label="Nawigacja główna">
          <a href="/lamiglowka/" aria-current={active === 'practice' ? 'page' : undefined}>Ćwicz</a>
          <a href="https://ejsymont.com/podstawy-architektury.html">Ucz się</a>
          <a href="https://ejsymont.com/architektura-w-ruchu.html">W ruchu</a>
          <a href="https://ejsymont.com/dlafirm.html">Dla firm</a>
        </nav>
        <a class="header-cta" href="https://ejsymont.com/generator.html">Generator HLD <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid"><div><a class="footer-brand" href="/">Architekt-Mentor</a><p>Praktyka architektury, krok po kroku.<br />Wiesław Ejsymont</p></div><div class="footer-links"><a href="/lamiglowka/">Łamigłówka</a><a href="https://ejsymont.com/antywzorce.html">Antywzorce</a><a href="https://ejsymont.com/podstawy-architektury.html">Podstawy</a><a href="mailto:architektura@sensinte.com">Kontakt</a></div></div><div class="container footer-base">Prototyp portalu · 2026 · <a href="https://ejsymont.com/informacja-o-danych.html">Informacja o danych</a></div></footer>
  </body>
</html>

<style is:global>
  :root{--ink:#182637;--muted:#536577;--navy:#142b3b;--teal:#136d73;--teal-dark:#0e5559;--mint:#e8f4ef;--paper:#f8f7f2;--white:#fff;--line:#dce4df;--orange:#e1a35d;--sans:'DM Sans',system-ui,sans-serif;--display:Manrope,system-ui,sans-serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:inherit}button,input,textarea{font:inherit}button{cursor:pointer}.container{width:min(100% - 40px,1180px);margin-inline:auto}.skip{position:absolute;left:-9999px;top:8px;z-index:100;padding:10px;background:#fff}.skip:focus{left:8px}a:focus-visible,button:focus-visible,textarea:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
  .site-header{position:sticky;top:0;z-index:20;background:rgba(248,247,242,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.bar{min-height:76px;display:flex;align-items:center;gap:28px}.brand{text-decoration:none;display:flex;align-items:center;gap:10px;white-space:nowrap}.brand-icon{display:grid;place-items:center;width:38px;height:38px;background:var(--teal);border-radius:10px;color:#fff;font:800 13px var(--display);letter-spacing:-.07em}.brand-dot{color:var(--orange)}.brand-name{font:800 18px var(--display);letter-spacing:-.055em}.brand-name span{font-weight:500}.site-header nav{display:flex;align-items:center;gap:28px;margin-left:auto}.site-header nav a{text-decoration:none;font-size:14px;font-weight:700;color:var(--muted)}.site-header nav a:hover,.site-header nav a[aria-current]{color:var(--teal)}.header-cta,.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--teal);background:var(--teal);color:#fff;text-decoration:none;font-weight:700;border-radius:9px;padding:12px 18px;line-height:1.3}.header-cta{font-size:13px;white-space:nowrap}.header-cta:hover,.button:hover{background:var(--teal-dark);border-color:var(--teal-dark)}.button.secondary{background:transparent;color:var(--teal)}.button.secondary:hover{background:var(--mint)}.eyebrow{display:flex;align-items:center;gap:8px;color:var(--teal);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.eyebrow::before{content:'';width:16px;height:2px;background:var(--orange)}h1,h2,h3{font-family:var(--display);line-height:1.18;letter-spacing:-.045em}p{margin-top:0}.muted{color:var(--muted)}.site-footer{background:var(--navy);color:#e7f2f1;padding:46px 0 18px}.footer-grid{display:flex;justify-content:space-between;gap:40px}.footer-brand{font:800 22px var(--display);text-decoration:none}.site-footer p{margin:10px 0 0;color:#b8cdd0}.footer-links{display:grid;grid-template-columns:repeat(2,max-content);gap:8px 34px}.footer-links a,.footer-base a{color:#d5e8e6;text-decoration:none}.footer-links a:hover,.footer-base a:hover{text-decoration:underline}.footer-base{margin-top:35px;padding-top:16px;border-top:1px solid #375261;font-size:12px;color:#a8c4c5}
  @media(max-width:920px){.bar{flex-wrap:wrap;padding-block:12px;gap:10px 20px}.site-header nav{order:3;width:100%;margin:0;overflow-x:auto;gap:20px;padding-bottom:2px}.header-cta{margin-left:auto}}
  @media(max-width:540px){.container{width:min(100% - 32px,1180px)}.brand-name{font-size:16px}.header-cta{font-size:12px;padding:10px}.footer-grid{display:block}.footer-links{margin-top:26px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
