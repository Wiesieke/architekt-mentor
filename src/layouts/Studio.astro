---
import { editions, latestEditionDate } from '../data/editions';
interface Props { title: string; description: string; active?: 'home' | 'practice' | 'tools'; locale?: 'pl' | 'en'; translationUrl?: string; published?: string; modified?: string; showEdition?: boolean }
const { title, description, active = 'home', locale = 'pl', translationUrl, published, modified, showEdition = false } = Astro.props;
// Production is indexable; previews stay private to search engines.
const indexable = process.env.VERCEL_ENV === 'production' || import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';
const canonical = new URL(Astro.url.pathname, 'https://ejsymont.com').href;
const editionDate = new Intl.DateTimeFormat('pl-PL',{day:'numeric',month:'long',timeZone:'UTC'}).format(new Date(`${latestEditionDate}T12:00:00Z`));
const editionCount = editions.filter(item => item.published === latestEditionDate).length;
const labels = {
  pl: { skip: 'Przejdź do treści', practice: 'Ćwicz', tools: 'Narzędzia', learn: 'Ucz się', trends: 'W ruchu', business: 'Dla firm', puzzle: 'Łamigłówka', patterns: 'Antywzorce', basics: 'Podstawy', contact: 'Kontakt', partner: 'Współpraca' },
  en: { skip: 'Skip to content', practice: 'Practice', tools: 'Tools', learn: 'Foundations', trends: 'In motion', business: 'For business', puzzle: 'Exercises', patterns: 'Anti-patterns', basics: 'Foundations', contact: 'Contact', partner: 'Partnerships' },
}[locale];
const languageUrl = translationUrl ?? (locale === 'pl' ? '/en/' : '/pl/');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    <title>{title} | ArchitectMentor</title>
    {indexable && <link rel="canonical" href={canonical} />}
    {indexable && translationUrl && <><link rel="alternate" hreflang="pl" href={locale === 'pl' ? canonical : new URL(translationUrl, 'https://ejsymont.com').href} /><link rel="alternate" hreflang="en" href={locale === 'en' ? canonical : new URL(translationUrl, 'https://ejsymont.com').href} />{(Astro.url.pathname === '/pl/' || Astro.url.pathname === '/en/') && <link rel="alternate" hreflang="x-default" href="https://ejsymont.com/" />}</>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ArchitectMentor" />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_GB'} />
    <meta property="og:title" content={`${title} | ArchitectMentor`} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    {published && <meta name="date" content={published} />}
    {modified && <meta name="date.modified" content={modified} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">{labels.skip}</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={locale === 'en' ? '/en/' : '/pl/'} aria-label={locale === 'en' ? 'ArchitectMentor — home' : 'ArchitectMentor — strona główna'}><span class="brand-icon" aria-hidden="true">AM<span class="brand-dot">.</span></span><span class="brand-name">Architect<span>Mentor</span></span></a>
        <nav aria-label={locale === 'en' ? 'Main navigation' : 'Nawigacja główna'}>
          {locale === 'pl' ? <><a href="/lamiglowka/" aria-current={active === 'practice' ? 'page' : undefined}>{labels.practice}</a><a href="/narzedzia/" aria-current={active === 'tools' ? 'page' : undefined}>{labels.tools}</a><a href="/podstawy-architektury/">{labels.learn}</a><a href="/architektura-w-ruchu/">{labels.trends}</a><a href="/dlafirm/">{labels.business}</a></> : <><a href="/en/practice/" aria-current={active === 'practice' ? 'page' : undefined}>{labels.practice}</a><a href="/en/tools/" aria-current={active === 'tools' ? 'page' : undefined}>{labels.tools}</a><a href="/en/foundations/">{labels.learn}</a><a href="/en/architecture-in-motion/">{labels.trends}</a><a href="/en/for-business/">{labels.business}</a></>}
        </nav>
        <a class="language-switch" href={languageUrl} lang={locale === 'en' ? 'pl' : 'en'} aria-label={locale === 'en' ? 'Read in Polish' : translationUrl ? 'Read this page in English' : 'English homepage'}>{locale === 'en' ? 'PL' : 'EN'}</a>
      </div>
      {showEdition && <a class="edition-strip" href="#nowe"><span class="edition-dot" aria-hidden="true"></span><strong>Nowe od {editionDate}:</strong> {editionCount} materiały do przeczytania i przećwiczenia <span aria-hidden="true">↓</span></a>}
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid"><div><a class="footer-brand" href={locale === 'en' ? '/en/' : '/pl/'}>ArchitectMentor</a><p>{locale === 'en' ? 'Practical architecture, one decision at a time.' : 'Praktyka architektury, krok po kroku.'}<br />Wiesław Ejsymont</p></div><div class="footer-links">{locale === 'pl' ? <><a href="/lamiglowka/">{labels.puzzle}</a><a href="/narzedzia/">{labels.tools}</a><a href="/antywzorce/">{labels.patterns}</a><a href="/podstawy-architektury/">{labels.basics}</a><a href="/dlafirm/#zapytanie">{labels.contact}</a><a href="mailto:architektura@sensinte.com?subject=Wsp%C3%B3%C5%82praca%20z%20ArchitectMentor">{labels.partner}</a></> : <><a href="/en/practice/">{labels.puzzle}</a><a href="/en/tools/">{labels.tools}</a><a href="/en/anti-patterns/">{labels.patterns}</a><a href="/en/foundations/">{labels.basics}</a><a href="/en/for-business/#enquiry">{labels.contact}</a><a href="/en/architecture-in-motion/">{labels.trends}</a></>}<a href={locale === 'pl' ? '/newsletter/' : '/en/newsletter/'}>Newsletter</a></div></div><div class="container footer-base">© 2026 ArchitectMentor · <a href={locale === 'pl' ? '/informacja-o-danych/' : '/en/data-notice/'}>{locale === 'pl' ? 'Informacja o danych' : 'Data notice'}</a></div></footer>
  </body>
</html>

<style is:global>
  :root{--ink:#182637;--muted:#536577;--navy:#142b3b;--teal:#136d73;--teal-dark:#0e5559;--mint:#e8f4ef;--paper:#f8f7f2;--white:#fff;--line:#dce4df;--orange:#e1a35d;--sans:'DM Sans',system-ui,sans-serif;--display:Manrope,system-ui,sans-serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:inherit}button,input,textarea{font:inherit}button{cursor:pointer}.container{width:min(100% - 40px,1180px);margin-inline:auto}.skip{position:absolute;left:-9999px;top:8px;z-index:100;padding:10px;background:#fff}.skip:focus{left:8px}a:focus-visible,button:focus-visible,textarea:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
  .site-header{position:sticky;top:0;z-index:20;background:rgba(248,247,242,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.bar{min-height:76px;display:flex;align-items:center;gap:28px}.brand{text-decoration:none;display:flex;align-items:center;gap:10px;white-space:nowrap}.brand-icon{display:grid;place-items:center;width:38px;height:38px;background:var(--teal);border-radius:10px;color:#fff;font:800 13px var(--display);letter-spacing:-.07em}.brand-dot{color:var(--orange)}.brand-name{font:800 18px var(--display);letter-spacing:-.055em}.brand-name span{font-weight:500}.site-header nav{display:flex;align-items:center;gap:28px;margin-left:auto}.site-header nav a{text-decoration:none;font-size:14px;font-weight:700;color:var(--muted)}.site-header nav a:hover,.site-header nav a[aria-current]{color:var(--teal)}.language-switch{flex:none;border:1px solid var(--line);border-radius:7px;padding:5px 9px;font-size:12px;font-weight:800;text-decoration:none;color:var(--teal)}.language-switch:hover{background:var(--mint)}.header-cta,.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--teal);background:var(--teal);color:#fff;text-decoration:none;font-weight:700;border-radius:9px;padding:12px 18px;line-height:1.3}.header-cta{font-size:13px;white-space:nowrap}.header-cta:hover,.button:hover{background:var(--teal-dark);border-color:var(--teal-dark)}.button.secondary{background:transparent;color:var(--teal)}.button.secondary:hover{background:var(--mint)}.eyebrow{display:flex;align-items:center;gap:8px;color:var(--teal);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.eyebrow::before{content:'';width:16px;height:2px;background:var(--orange)}h1,h2,h3{font-family:var(--display);line-height:1.18;letter-spacing:-.045em}p{margin-top:0}.muted{color:var(--muted)}.site-footer{background:var(--navy);color:#e7f2f1;padding:46px 0 18px}.footer-grid{display:flex;justify-content:space-between;gap:40px}.footer-brand{font:800 22px var(--display);text-decoration:none}.site-footer p{margin:10px 0 0;color:#b8cdd0}.footer-links{display:grid;grid-template-columns:repeat(2,max-content);gap:8px 34px}.footer-links a,.footer-base a{color:#d5e8e6;text-decoration:none}.footer-links a:hover,.footer-base a:hover{text-decoration:underline}.footer-base{margin-top:35px;padding-top:16px;border-top:1px solid #375261;font-size:12px;color:#a8c4c5}
  .edition-strip{display:flex;align-items:center;justify-content:center;gap:8px;padding:8px 20px;background:#e8f4ef;color:#125d61;font-size:12px;text-decoration:none;line-height:1.35}.edition-strip:hover{text-decoration:underline}.edition-dot{width:7px;height:7px;border-radius:50%;background:#dc9351;flex:none}.edition-strip strong{font-weight:800}
  @media(max-width:920px){.bar{flex-wrap:wrap;padding-block:12px;gap:10px 20px}.site-header nav{order:3;width:100%;margin:0;overflow-x:auto;gap:20px;padding-bottom:2px}.language-switch{margin-left:auto}.header-cta{margin-left:auto}}
  @media(max-width:540px){.container{width:min(100% - 32px,1180px)}.brand-name{font-size:16px}.header-cta{font-size:12px;padding:10px}.footer-grid{display:block}.footer-links{margin-top:26px}.edition-strip{flex-wrap:wrap;gap:3px 6px;padding:9px 16px;font-size:11px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
