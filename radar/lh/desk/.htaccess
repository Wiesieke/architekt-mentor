# LH.pl self-contained ArchitectMentor Desk. Never put secrets in this directory.
Options -Indexes
RewriteEngine On
RewriteRule ^\.vault(?:/|$) - [F,L,NC]
<FilesMatch "^(auth|totp|desk-db|wordpress-draft)\.php$">
 Require all denied
</FilesMatch>
<FilesMatch "\.(?:md|json|log|sql|yml|yaml|ini|env|bak|old|orig)$">
 Require all denied
</FilesMatch>
