# Separate GitHub OAuth application per desk. All variables are server-only.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated immutable numeric GitHub account IDs. Empty means deny all.
DESK_ALLOWED_GITHUB_IDS=
# Protected LH.pl endpoints; no credentials are ever exposed as NEXT_PUBLIC_*.
AM_RADAR_API_URL=https://mentor-api.sensinte.com/architect-radar-api/index.php
AM_RADAR_API_TOKEN=
AM_RADAR_EDITOR_API_URL=https://mentor-api.sensinte.com/architect-radar-api/editorial.php
AM_RADAR_EDITOR_API_TOKEN=
